<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight">Estado del Sistema</h1>
        <p class="text-sm text-gray-500 mt-1">Monitorización en tiempo real de servicios, dominios y APIs</p>
      </div>
      <div class="text-right">
        <span class="text-xs text-gray-400">Última actualización</span>
        <p class="text-sm font-medium text-gray-700"><%= Time.current.strftime("%H:%M UTC") %></p>
      </div>
    </div>

    <% if @all_operational %>
      <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded-r-lg shadow-sm mb-8 flex items-center gap-3">
        <span class="flex h-3 w-3 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
        </span>
        <div>
          <h3 class="text-sm font-semibold text-green-900">Todos los sistemas están operativos</h3>
          <p class="text-xs text-green-700"><%= @operational_count %> de <%= @total_count %> servicios respondiendo correctamente</p>
        </div>
      </div>
    <% else %>
      <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg shadow-sm mb-8 flex items-center gap-3">
        <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
        <div>
          <h3 class="text-sm font-semibold text-red-900">Incidencia detectada</h3>
          <p class="text-xs text-red-700"><%= @down_resources.size %> de <%= @total_count %> servicios presentan problemas de conexión</p>
        </div>
      </div>
    <% end %>

    <%# Bloque Dominios Web %>
    <% if @domains.any? %>
      <div class="mb-8">
        <h2 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-3">Dominios Web</h2>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-6 py-3 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
            <span>Servicio</span>
            <span>Estado</span>
          </div>

          <ul class="divide-y divide-gray-100">
            <% @domains.each do |domain| %>
              <li class="px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition">
                <div>
                  <% if domain.public_token.present? %>
                    <%= link_to domain.name, public_status_path(domain.public_token), class: "text-sm font-medium text-gray-900 hover:text-amber-600 transition" %>
                  <% else %>
                    <span class="text-sm font-medium text-gray-900"><%= domain.name %></span>
                  <% end %>
                  <p class="text-xs text-gray-400 font-mono"><%= domain.url %></p>
                </div>

                <div class="flex items-center gap-4">
                  <% if domain.last_response_time_ms.present? %>
                    <span class="text-xs text-gray-400 font-mono"><%= domain.last_response_time_ms %> ms</span>
                  <% end %>
                  <% if domain.status_up? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Operativo
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Degradado / Caído
                    </span>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%# Bloque Endpoints API %>
    <% if @api_endpoints.any? %>
      <div class="mb-8">
        <h2 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-3">Endpoints API</h2>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-6 py-3 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
            <span>Endpoint</span>
            <span>Estado</span>
          </div>

          <ul class="divide-y divide-gray-100">
            <% @api_endpoints.each do |endpoint| %>
              <li class="px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="px-1.5 py-0.5 text-[10px] font-mono font-bold rounded bg-gray-100 text-gray-700 uppercase">
                      <%= endpoint.http_method %>
                    </span>
                    <% if endpoint.public_token.present? %>
                      <%= link_to endpoint.name, public_status_path(endpoint.public_token), class: "text-sm font-medium text-gray-900 hover:text-amber-600 transition" %>
                    <% else %>
                      <span class="text-sm font-medium text-gray-900"><%= endpoint.name %></span>
                    <% end %>
                  </div>
                  <p class="text-xs text-gray-400 font-mono mt-0.5"><%= endpoint.url %></p>
                </div>

                <div class="flex items-center gap-4">
                  <% if endpoint.last_response_time_ms.present? %>
                    <span class="text-xs text-gray-400 font-mono"><%= endpoint.last_response_time_ms %> ms</span>
                  <% end %>
                  <% if endpoint.status_up? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Operativo
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Degradado / Caído
                    </span>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="mt-8 text-center">
      <p class="text-xs text-gray-400">Powered by Domain Monitor</p>
    </div>
  </div>
</div>
