<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Volver a la lista", admin_users_path, class: "text-blue-500 hover:text-blue-700" %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4" role="alert">
      <p><%= notice %></p>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h1 class="text-2xl font-bold">Detalles del Usuario</h1>
    </div>
    
    <div class="p-6">
      <div class="mb-4">
        <h3 class="text-gray-600 font-semibold">Email:</h3>
        <p class="text-gray-800"><%= @user.email %></p>
      </div>
      
      <div class="mb-4">
        <h3 class="text-gray-600 font-semibold">Rol:</h3>
        <p>
          <span class="<%= @user.admin? ? 'bg-red-200 text-red-800' : (@user.manager? ? 'bg-yellow-200 text-yellow-800' : 'bg-green-200 text-green-800') %> py-1 px-2 rounded-full text-sm">
            <%= @user.role.capitalize %>
          </span>
        </p>
      </div>
      
      <div class="mb-4">
        <h3 class="text-gray-600 font-semibold">Fecha de creación:</h3>
        <p class="text-gray-800"><%= @user.created_at.strftime('%d/%m/%Y %H:%M') %></p>
      </div>
      
      <div class="mb-4">
        <h3 class="text-gray-600 font-semibold">Última actualización:</h3>
        <p class="text-gray-800"><%= @user.updated_at.strftime('%d/%m/%Y %H:%M') %></p>
      </div>
    </div>
    
    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between">
      <%= link_to "Editar", edit_admin_user_path(@user), class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded" %>
      <%= button_to "Eliminar", admin_user_path(@user), method: :delete, data: { confirm: "¿Estás seguro de que deseas eliminar este usuario?" }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>
</div>