<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Administración de Usuarios</h1>
    <%= link_to "Nuevo Usuario", new_admin_user_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4" role="alert">
      <p><%= notice %></p>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded my-6 overflow-x-auto">
    <table class="min-w-full bg-white">
      <thead class="bg-gray-800 text-white">
        <tr>
          <th class="py-3 px-4 text-left">Email</th>
          <th class="py-3 px-4 text-left">Rol</th>
          <th class="py-3 px-4 text-left">Fecha de creación</th>
          <th class="py-3 px-4 text-left">Acciones</th>
        </tr>
      </thead>
      <tbody class="text-gray-700">
        <% @users.each do |user| %>
          <tr class="border-b hover:bg-gray-100">
            <td class="py-3 px-4"><%= user.email %></td>
            <td class="py-3 px-4"><span class="<%= user.admin? ? 'bg-red-200 text-red-800' : (user.manager? ? 'bg-yellow-200 text-yellow-800' : 'bg-green-200 text-green-800') %> py-1 px-2 rounded-full text-xs"><%= user.role.capitalize %></span></td>
            <td class="py-3 px-4"><%= user.created_at.strftime('%d/%m/%Y') %></td>
            <td class="py-3 px-4">
              <div class="flex space-x-2">
                <%= link_to "Ver", admin_user_path(user), class: "text-blue-500 hover:text-blue-700" %>
                <%= link_to "Editar", edit_admin_user_path(user), class: "text-yellow-500 hover:text-yellow-700" %>
                <%= button_to "Eliminar", admin_user_path(user), method: :delete, data: { confirm: "¿Estás seguro?" }, class: "text-red-500 hover:text-red-700" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>