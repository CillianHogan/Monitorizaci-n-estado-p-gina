<!DOCTYPE html>
<html lang="es" class="h-full antialiased selection:bg-amber-300 selection:text-amber-950">
  <head>
    <title><%= content_for(:title) || "Domain Checker — Monitorización de Dominios y APIs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
      
      /* Fondo cálido ámbar/terracota profundo, mucho más iluminado */
      .bg-radial-warm {
        background-color: #1a1412;
        background-image: 
          radial-gradient(at 0% 0%, rgba(217, 119, 6, 0.28) 0px, transparent 55%),
          radial-gradient(at 100% 0%, rgba(234, 88, 12, 0.22) 0px, transparent 55%),
          radial-gradient(at 50% 100%, rgba(180, 83, 9, 0.20) 0px, transparent 65%);
      }
      .bg-grid-pattern {
        background-size: 32px 32px;
        background-image: 
          linear-gradient(to right, rgba(254, 215, 170, 0.05) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(254, 215, 170, 0.05) 1px, transparent 1px);
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col justify-between bg-radial-warm text-amber-50 relative overflow-x-hidden">
    <div class="fixed inset-0 bg-grid-pattern pointer-events-none z-0"></div>
    <div class="fixed -top-40 left-1/2 -translate-x-1/2 w-[850px] h-[380px] bg-gradient-to-b from-amber-500/30 via-orange-500/15 to-transparent blur-3xl rounded-full pointer-events-none z-0"></div>

    <header class="sticky top-0 z-40 w-full border-b border-amber-500/20 bg-[#1f1714]/85 backdrop-blur-xl shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          
          <%# Marca Domain Checker %>
          <div class="flex items-center gap-8">
            <%= link_to root_path, class: "flex items-center gap-3.5 group focus:outline-none" do %>
              <div class="relative h-10 w-10 rounded-xl bg-gradient-to-br from-amber-500 via-orange-500 to-amber-700 p-0.5 shadow-md shadow-orange-950/40 group-hover:scale-105 transition-transform duration-200">
                <div class="h-full w-full bg-[#18110f] rounded-[10px] flex items-center justify-center">
                  <svg class="w-5 h-5 text-amber-400 group-hover:rotate-12 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-2">
                  <span class="text-base font-extrabold tracking-tight text-white group-hover:text-amber-300 transition-colors">Domain Checker</span>
                  <% if user_signed_in? && current_user.respond_to?(:admin?) && current_user.admin? %>
                    <span class="text-[9px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">Pro</span>
                  <% elsif user_signed_in? %>
                    <span class="text-[9px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded bg-stone-800/80 text-amber-200/60 border border-stone-700/50">Free</span>
                  <% end %>
                </div>
                <span class="text-[10px] text-amber-200/60 font-medium tracking-wide">Uptime & Latency Monitor</span>
              </div>
            <% end %>

            <% if user_signed_in? %>
              <%= link_to "Canales", notification_channels_path, class: "px-3 py-1.5 rounded-lg border border-amber-600/50 text-amber-300 hover:text-white hover:border-amber-400 text-xs font-bold transition-all" %>
              <nav class="hidden md:flex items-center gap-1.5 pl-4 border-l border-amber-500/20">
                <%= link_to "Dominios", domains_path, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg #{current_page?(domains_path) ? 'text-amber-200 bg-amber-500/20 border border-amber-500/40' : 'text-amber-100/70 hover:text-white hover:bg-white/5'} transition-all" %>
                <%= link_to "Endpoints API", api_endpoints_path, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg #{current_page?(api_endpoints_path) ? 'text-amber-200 bg-amber-500/20 border border-amber-500/40' : 'text-amber-100/70 hover:text-white hover:bg-white/5'} transition-all" %>
                <% if respond_to?(:admin_users_path) && current_user.respond_to?(:admin?) && current_user.admin? %>
                  <%= link_to "Administración", admin_users_path, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg #{current_page?(admin_users_path) ? 'text-amber-200 bg-amber-500/20 border border-amber-500/40' : 'text-amber-100/70 hover:text-white hover:bg-white/5'} transition-all" %>
                <% end %>
              </nav>
            <% end %>
          </div>

          <%# Área de Usuario con enlace directo al Perfil %>
          <div class="flex items-center gap-3">
            <% if user_signed_in? %>
              <%= link_to edit_user_registration_path, title: "Editar mi perfil", class: "hidden sm:flex items-center gap-2.5 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/25 px-3 py-1.5 rounded-xl transition group" do %>
                <div class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></div>
                <span class="text-xs font-medium text-amber-100 group-hover:text-white"><%= current_user.email %></span>
                <svg class="w-3.5 h-3.5 text-amber-400/70 group-hover:text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              <% end %>

              <%= button_to destroy_user_session_path, method: :delete, class: "inline-flex items-center gap-1.5 text-xs font-medium text-amber-200/80 hover:text-white px-3 py-1.5 rounded-lg border border-amber-500/20 bg-amber-500/10 hover:bg-rose-500/20 hover:border-rose-500/30 hover:text-rose-300 transition-all cursor-pointer" do %>
                <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span>Salir</span>
              <% end %>
            <% else %>
              <%= link_to "Iniciar Sesión", new_user_session_path, class: "text-xs font-semibold text-amber-200 hover:text-white px-3 py-1.5 transition-colors" %>
              <%= link_to "Comenzar", new_user_registration_path, class: "inline-flex items-center text-xs font-bold text-stone-950 bg-gradient-to-r from-amber-400 via-amber-300 to-orange-400 hover:from-amber-300 hover:to-orange-300 px-4 py-2 rounded-xl shadow-lg shadow-amber-500/25 transition-all" %>
            <% end %>
          </div>

        </div>
      </div>
    </header>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4">
      <%= render 'shared/flash_messages' %>
    </div>

    <main class="relative z-10 flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <footer class="relative z-10 border-t border-amber-500/15 bg-[#18110f]/90 backdrop-blur-md mt-20 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2.5 text-xs text-amber-200/70">
          <div class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></div>
          <span class="font-medium">Red de monitorización activa</span>
        </div>
        <p class="text-xs text-amber-300/40 font-mono">
          Domain Checker &bull; Rails 8 &bull; Heroku-24
        </p>
      </div>
    </footer>
  </body>
</html>
