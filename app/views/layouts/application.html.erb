<!DOCTYPE html>
<html lang="es" class="h-full antialiased selection:bg-amber-200 selection:text-amber-950">
  <head>
    <title><%= content_for(:title) || "Domain Checker — Monitorización de Dominios y APIs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
      
      .bg-radial-warm {
        background-color: #0c0a09;
        background-image: 
          radial-gradient(at 0% 0%, rgba(245, 158, 11, 0.18) 0px, transparent 50%),
          radial-gradient(at 100% 0%, rgba(234, 88, 12, 0.14) 0px, transparent 50%),
          radial-gradient(at 50% 100%, rgba(217, 119, 6, 0.12) 0px, transparent 60%);
      }
      .bg-grid-pattern {
        background-size: 32px 32px;
        background-image: 
          linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col justify-between bg-radial-warm text-stone-100 relative overflow-x-hidden">
    <div class="fixed inset-0 bg-grid-pattern pointer-events-none z-0"></div>
    <div class="fixed -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-amber-500/25 via-orange-600/10 to-transparent blur-3xl rounded-full pointer-events-none z-0"></div>

    <header class="sticky top-0 z-40 w-full border-b border-white/[0.08] bg-stone-950/70 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          
          <%# Marca original: Domain Checker %>
          <div class="flex items-center gap-8">
            <%= link_to root_path, class: "flex items-center gap-3.5 group focus:outline-none" do %>
              <div class="relative h-10 w-10 rounded-xl bg-gradient-to-br from-amber-500 via-orange-500 to-amber-700 p-0.5 shadow-lg shadow-orange-500/20 group-hover:shadow-amber-500/30 transition-all duration-300">
                <div class="h-full w-full bg-stone-950 rounded-[10px] flex items-center justify-center">
                  <svg class="w-5 h-5 text-amber-400 group-hover:scale-110 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-2">
                  <span class="text-base font-extrabold tracking-tight text-white group-hover:text-amber-300 transition-colors">Domain Checker</span>
                  <span class="text-[9px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">Pro</span>
                </div>
                <span class="text-[10px] text-stone-400 font-medium tracking-wide">Uptime & Latency Monitor</span>
              </div>
            <% end %>

            <% if user_signed_in? %>
              <nav class="hidden md:flex items-center gap-1.5 pl-4 border-l border-white/10">
                <%= link_to "Dominios", domains_path, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg #{current_page?(domains_path) ? 'text-amber-300 bg-amber-500/15 border border-amber-500/30' : 'text-stone-300 hover:text-white hover:bg-white/5'} transition-all" %>
                <%= link_to "Endpoints API", api_endpoints_path, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg #{current_page?(api_endpoints_path) ? 'text-amber-300 bg-amber-500/15 border border-amber-500/30' : 'text-stone-300 hover:text-white hover:bg-white/5'} transition-all" %>
                <% if respond_to?(:admin_users_path) && current_user.respond_to?(:admin?) && current_user.admin? %>
                  <%= link_to "Administración", admin_users_path, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg #{current_page?(admin_users_path) ? 'text-amber-300 bg-amber-500/15 border border-amber-500/30' : 'text-stone-300 hover:text-white hover:bg-white/5'} transition-all" %>
                <% end %>
              </nav>
            <% end %>
          </div>

          <div class="flex items-center gap-4">
            <% if user_signed_in? %>
              <div class="hidden sm:flex items-center gap-3 bg-white/5 border border-white/10 px-3 py-1.5 rounded-xl">
                <div class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></div>
                <span class="text-xs font-medium text-stone-300"><%= current_user.email %></span>
              </div>

              <%= button_to destroy_user_session_path, method: :delete, class: "inline-flex items-center gap-1.5 text-xs font-medium text-stone-300 hover:text-white px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 hover:bg-red-500/20 hover:border-red-500/30 hover:text-red-300 transition-all cursor-pointer" do %>
                <svg class="w-3.5 h-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span>Salir</span>
              <% end %>
            <% else %>
              <%= link_to "Iniciar Sesión", new_user_session_path, class: "text-xs font-semibold text-stone-300 hover:text-white px-3 py-1.5 transition-colors" %>
              <%= link_to "Comenzar", new_user_registration_path, class: "inline-flex items-center text-xs font-bold text-stone-950 bg-gradient-to-r from-amber-400 via-amber-300 to-orange-400 hover:from-amber-300 hover:to-orange-300 px-4 py-2 rounded-xl shadow-lg shadow-amber-500/25 transition-all" %>
            <% end %>
          </div>

        </div>
      </div>
    </header>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4">
      <%= render 'shared/flash_messages' %>
    </div>

    <main class="relative z-10 flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <footer class="relative z-10 border-t border-white/10 bg-stone-950/80 backdrop-blur-md mt-20 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2.5 text-xs text-stone-400">
          <div class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></div>
          <span class="font-medium">Red de monitorización activa</span>
        </div>
        <p class="text-xs text-stone-500 font-mono">
          Domain Checker &bull; Rails 8 &bull; Heroku-24
        </p>
      </div>
    </footer>
  </body>
</html>
