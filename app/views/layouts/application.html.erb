<!DOCTYPE html>
<html class="h-full bg-stone-950 text-stone-100">
  <head>
    <title translate="no" class="notranslate"><%= content_for(:title) || "Domain Checker - Website & API Monitoring" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      .goog-te-banner-frame.skiptranslate, .goog-te-gadget-icon, .goog-te-menu-value span:nth-child(3), .goog-te-menu-value span:nth-child(5) { display: none !important; }
      body { top: 0px !important; }
      #google_translate_element { display: none !important; }
      .skiptranslate iframe { display: none !important; }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-stone-950 font-sans antialiased selection:bg-amber-500 selection:text-stone-950">
    <div id="google_translate_element"></div>
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
      <div class="absolute -top-[40%] left-[20%] w-[600px] h-[600px] rounded-full bg-gradient-to-br from-amber-600/10 via-orange-600/5 to-transparent blur-3xl"></div>
      <div class="absolute top-[60%] -right-[10%] w-[500px] h-[500px] rounded-full bg-gradient-to-tl from-amber-700/10 via-amber-900/5 to-transparent blur-3xl"></div>
    </div>

    <!-- Navegación Principal con I18n Controller -->
    <nav class="border-b border-stone-800 bg-stone-900/80 backdrop-blur-md sticky top-0 z-50" data-controller="i18n">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-8">
            <%= link_to root_path, class: "flex items-center gap-3.5 group focus:outline-none" do %>
              <div class="relative h-10 w-10 rounded-xl bg-gradient-to-br from-amber-500 via-orange-500 to-amber-700 p-0.5 shadow-md shadow-orange-950/40 group-hover:scale-105 transition-transform duration-200">
                <div class="h-full w-full bg-stone-950 rounded-[10px] flex items-center justify-center">
                  <svg class="h-5 w-5 text-amber-500 group-hover:text-amber-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
              </div>
              <span class="text-xl font-black tracking-tight text-white group-hover:text-amber-400 transition-colors notranslate" translate="no">
                Domain<span class="text-amber-500">Checker</span>
              </span>
            <% end %>

            <!-- Selector de Idioma Persistente -->
            <div class="notranslate flex items-center gap-1.5 text-xs font-bold bg-stone-900/90 border border-amber-500/20 px-2.5 py-1 rounded-lg" translate="no">
              <button type="button" data-action="click->i18n#setEnglish" data-i18n-target="btnEn" class="cursor-pointer text-amber-400 font-bold transition">English</button>
              <span class="text-stone-600">|</span>
              <button type="button" data-action="click->i18n#setSpanish" data-i18n-target="btnEs" class="cursor-pointer text-stone-400 hover:text-white transition">Español</button>
            </div>

            <% if user_signed_in? %>
              <div class="hidden md:flex items-center gap-1">
                <%= link_to domains_path, class: "px-3.5 py-2 text-sm font-semibold rounded-lg transition-all #{current_page?(domains_path) ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'text-stone-400 hover:text-stone-200 hover:bg-stone-800/60'}" do %>
                  <span data-i18n-en="Domains" data-i18n-es="Dominios">Domains</span>
                <% end %>

                <%= link_to api_endpoints_path, class: "px-3.5 py-2 text-sm font-semibold rounded-lg transition-all #{current_page?(api_endpoints_path) ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'text-stone-400 hover:text-stone-200 hover:bg-stone-800/60'}" do %>
                  <span class="notranslate" translate="no">API Endpoints</span>
                <% end %>

                <%= link_to pricing_path, class: "px-3.5 py-2 text-sm font-semibold rounded-lg transition-all #{current_page?(pricing_path) ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'text-stone-400 hover:text-stone-200 hover:bg-stone-800/60'}" do %>
                  <span data-i18n-en="Pricing" data-i18n-es="Precios">Pricing</span>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="flex items-center gap-4">
            <% if user_signed_in? %>
              <div class="relative" data-controller="dropdown">
                <button type="button" data-action="click->dropdown#toggle" class="flex items-center gap-2 p-1.5 rounded-xl bg-stone-900 border border-stone-800 hover:border-amber-500/30 transition text-stone-300">
                  <div class="w-7 h-7 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center font-bold text-xs text-amber-400 notranslate" translate="no">
                    <%= current_user.email[0].upcase %>
                  </div>
                  <span class="text-xs font-medium pr-1 hidden sm:inline notranslate" translate="no"><%= current_user.email %></span>
                </button>

                <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-stone-900 border border-stone-800 rounded-xl shadow-xl py-1 z-50">
                  <%= link_to notification_channels_path, class: "block px-4 py-2 text-xs text-stone-300 hover:bg-stone-800 hover:text-white" do %>
                    <span data-i18n-en="Channels" data-i18n-es="Canales">Channels</span>
                  <% end %>
                  <%= link_to edit_user_registration_path, class: "block px-4 py-2 text-xs text-stone-300 hover:bg-stone-800 hover:text-white" do %>
                    <span data-i18n-en="My Account" data-i18n-es="Mi Cuenta">My Account</span>
                  <% end %>
                  <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-xs text-red-400 hover:bg-stone-800 hover:text-red-300" do %>
                    <span data-i18n-en="Log Out" data-i18n-es="Cerrar Sesión">Log Out</span>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="flex items-center gap-3">
                <%= link_to new_user_session_path, class: "text-sm font-semibold text-stone-400 hover:text-white transition" do %>
                  <span data-i18n-en="Sign In" data-i18n-es="Iniciar Sesión">Sign In</span>
                <% end %>
                <%= link_to new_user_registration_path, class: "px-4 py-2 text-sm font-semibold bg-amber-500 hover:bg-amber-400 text-stone-950 rounded-xl transition shadow-sm font-bold" do %>
                  <span data-i18n-en="Sign Up" data-i18n-es="Registrarse">Sign Up</span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Contenido y Flashes -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= render "shared/flash_messages" %>
      <%= yield %>
    </main>
  </body>
</html>