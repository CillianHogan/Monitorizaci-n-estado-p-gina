<!DOCTYPE html>
<html lang="es" class="h-full bg-[#faf8f5] text-stone-900 antialiased selection:bg-amber-100 selection:text-amber-900">
  <head>
    <title><%= content_for(:title) || "Pulse | Modern Domain & API Monitoring" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Tipografía Inter limpia %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
      code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>

  <body class="min-h-full flex flex-col justify-between bg-[#faf8f5]">
    <%# Navbar moderna cálida con efecto glassmorphism %>
    <header class="sticky top-0 z-40 w-full border-b border-stone-200/80 bg-[#faf8f5]/85 backdrop-blur-md transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          
          <%# Logo & Marca %>
          <div class="flex items-center gap-6">
            <%= link_to root_path, class: "flex items-center gap-3 group focus:outline-none" do %>
              <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-amber-600 to-orange-500 flex items-center justify-center shadow-sm shadow-amber-500/20 group-hover:scale-105 transition-transform duration-200">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-base font-bold tracking-tight text-stone-900 group-hover:text-amber-800 transition-colors">Pulse</span>
                <span class="text-[10px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded-md bg-amber-100/70 text-amber-800 border border-amber-200/60">Pro</span>
              </div>
            <% end %>

            <%# Enlaces principales %>
            <% if user_signed_in? %>
              <nav class="hidden md:flex items-center gap-1">
                <%= link_to "Dominios", domains_path, class: "px-3 py-1.5 text-sm font-medium rounded-lg #{current_page?(domains_path) ? 'text-amber-900 bg-amber-500/10 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-200/50'} transition-all" %>
                <%= link_to "Endpoints API", api_endpoints_path, class: "px-3 py-1.5 text-sm font-medium rounded-lg #{current_page?(api_endpoints_path) ? 'text-amber-900 bg-amber-500/10 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-200/50'} transition-all" %>
                <% if respond_to?(:admin_users_path) && current_user.respond_to?(:admin?) && current_user.admin? %>
                  <%= link_to "Usuarios", admin_users_path, class: "px-3 py-1.5 text-sm font-medium rounded-lg #{current_page?(admin_users_path) ? 'text-amber-900 bg-amber-500/10 font-semibold' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-200/50'} transition-all" %>
                <% end %>
              </nav>
            <% end %>
          </div>

          <%# Área de Usuario %>
          <div class="flex items-center gap-3">
            <% if user_signed_in? %>
              <div class="hidden sm:flex flex-col text-right">
                <span class="text-xs font-semibold text-stone-800"><%= current_user.email.split('@').first %></span>
                <span class="text-[11px] text-stone-500"><%= current_user.email %></span>
              </div>
              
              <div class="h-4 w-px bg-stone-200 hidden sm:block"></div>

              <%= button_to destroy_user_session_path, method: :delete, class: "inline-flex items-center gap-1.5 text-xs font-medium text-stone-600 hover:text-stone-950 px-3 py-1.5 rounded-lg border border-stone-200/80 bg-white/70 hover:bg-white shadow-2xs hover:shadow-xs transition-all cursor-pointer" do %>
                <svg class="w-3.5 h-3.5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span>Salir</span>
              <% end %>
            <% else %>
              <%= link_to "Iniciar Sesión", new_user_session_path, class: "text-sm font-medium text-stone-700 hover:text-stone-950 px-3 py-1.5 transition-colors" %>
              <%= link_to "Comenzar", new_user_registration_path, class: "inline-flex items-center text-sm font-semibold text-white bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 px-4 py-1.5 rounded-xl shadow-xs shadow-amber-600/20 transition-all" %>
            <% end %>
          </div>

        </div>
      </div>
    </header>

    <%# Contenedor de Alertas Flash Flotantes %>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4">
      <%= render 'shared/flash_messages' %>
    </div>

    <%# Contenido Principal %>
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <%# Footer cálido y minimalista %>
    <footer class="border-t border-stone-200/70 bg-[#faf8f5] mt-16 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs text-stone-500">
          <div class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span>Sistemas de monitorización operativos</span>
        </div>
        <p class="text-xs text-stone-600">
          Pulse Engine &bull; Rails 8 &bull; SolidQueue
        </p>
      </div>
    </footer>
  </body>
</html>
