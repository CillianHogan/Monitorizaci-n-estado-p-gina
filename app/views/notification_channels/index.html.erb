<div class="max-w-6xl mx-auto px-4 py-8 space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Canales de Notificación</h1>
      <p class="text-sm text-amber-200/80 mt-1">Configura tus correos, webhooks de Discord y bots de Telegram para recibir alertas.</p>
    </div>
    <%= link_to "← Volver a Dominios", domains_path, class: "inline-flex items-center text-sm font-semibold text-amber-400 hover:text-amber-300" %>
  </div>

  <div class="bg-[#1a120b] border-2 border-amber-800/40 rounded-2xl p-6 shadow-xl">
    <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
      Añadir Nuevo Canal
    </h2>

    <form action="<%= notification_channels_path %>" method="post" class="space-y-4">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-amber-300/80 mb-1">Nombre / Alias</label>
          <input type="text" name="notification_channel[name]" placeholder="Ej. Alertas Discord, Correo Trabajo" required class="w-full px-3 py-2 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white placeholder-amber-200/30 text-sm focus:border-amber-400 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-amber-300/80 mb-1">Tipo de Canal</label>
          <select name="notification_channel[channel_type]" class="w-full px-3 py-2 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white text-sm focus:border-amber-400 focus:outline-none">
            <option value="email">Correo Electrónico</option>
            <% if current_user.pro? %>
              <option value="discord">Discord (Webhook URL)</option>
              <option value="telegram">Telegram (Chat ID)</option>
            <% else %>
              <option value="discord" disabled class="text-stone-500">Discord (Exclusivo Plan PRO)</option>
              <option value="telegram" disabled class="text-stone-500">Telegram (Exclusivo Plan PRO)</option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-amber-300/80 mb-1">Destino / Valor</label>
          <input type="text" name="notification_channel[destination]" placeholder="correo@ejemplo.com / URL webhook / chat id" required class="w-full px-3 py-2 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white placeholder-amber-200/30 text-sm focus:border-amber-400 focus:outline-none">
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-amber-200/80">
          <input type="checkbox" name="notification_channel[is_default]" value="1" class="rounded border-amber-700 text-amber-500 focus:ring-amber-400 bg-[#0d0905]">
          <span>Marcar como canal predeterminado de este tipo</span>
        </label>

        <button type="submit" class="px-5 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-extrabold text-sm shadow cursor-pointer transition-all">
          + Guardar Canal
        </button>
      </div>
    </form>
  </div>

  <div class="space-y-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-amber-800/30">
      <div>
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
          <span>Canales Configurados</span>
          <span id="channels-count" class="text-xs px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-semibold">(<%= @channels.size %>)</span>
        </h2>
        <p class="text-xs text-amber-200/60 mt-0.5">Encuentra y gestiona rápidamente tus métodos de alerta.</p>
      </div>

      <%# Barra de Búsqueda y Filtro de Tipo %>
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5">
        <div class="relative w-full sm:w-64">
          <input type="text" id="channel-search-input" oninput="filterChannels()" placeholder="Buscar por nombre o destino..." class="w-full pl-8 pr-3 py-1.5 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white placeholder-amber-200/30 text-xs focus:border-amber-400 focus:outline-none transition">
          <svg class="w-4 h-4 text-amber-400/60 absolute left-2.5 top-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <select id="channel-type-filter" onchange="filterChannels()" class="w-full sm:w-auto px-3 py-1.5 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white text-xs focus:border-amber-400 focus:outline-none cursor-pointer">
          <option value="all">Todos los tipos</option>
          <option value="email">Email</option>
          <option value="discord">Discord</option>
          <option value="telegram">Telegram</option>
        </select>
      </div>
    </div>

    <% if @channels.empty? %>
      <div class="bg-[#1a120b] border-2 border-amber-800/30 rounded-2xl p-8 text-center text-amber-200/60 text-sm">
        No tienes canales configurados aún. Añade uno arriba para usarlo como predeterminado en tus servicios.
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @channels.each do |channel| %>
          <div class="channel-card bg-[#1a120b] border-2 <%= channel.is_default? ? "border-amber-400" : "border-amber-900/40" %> rounded-2xl p-5 shadow-lg flex flex-col justify-between space-y-4" data-name="<%= channel.name.to_s.downcase %>" data-destination="<%= channel.destination.to_s.downcase %>" data-type="<%= channel.channel_type.to_s.downcase %>">
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2 py-0.5 text-xs font-bold rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase">
                  <%= channel.channel_type %>
                </span>
                <% if channel.is_default? %>
                  <span class="px-2 py-0.5 text-xs font-extrabold rounded-full bg-emerald-950 text-emerald-400 border border-emerald-500/50 uppercase">
                    Predeterminado
                  </span>
                <% end %>
              </div>

              <h3 class="text-base font-bold text-white truncate"><%= channel.name %></h3>
              <p class="text-xs text-amber-200/70 font-mono break-all"><%= channel.destination %></p>
            </div>

            <div class="pt-3 border-t border-amber-800/30 flex items-center justify-between gap-2">
              <% unless channel.is_default? %>
                <%= button_to "Hacer Predeterminado", set_default_notification_channel_path(channel), method: :patch, class: "text-xs font-bold text-amber-400 hover:text-amber-300 underline cursor-pointer" %>
              <% else %>
                <span class="text-xs text-emerald-400 font-semibold">Canal principal</span>
              <% end %>

              <%= button_to "Eliminar", notification_channel_path(channel), method: :delete, data: { turbo_confirm: "¿Seguro que deseas eliminar este canal?" }, class: "text-xs font-bold text-red-400 hover:text-red-300 cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
      <div id="no-channels-match" class="hidden bg-[#1a120b] border-2 border-amber-800/30 rounded-2xl p-8 text-center text-amber-200/60 text-sm">
        No se encontraron canales que coincidan con los filtros aplicados.
      </div>
    <% end %>
  </div>
</div>

<script>
  function filterChannels() {
    var search = (document.getElementById("channel-search-input")?.value || "").trim().toLowerCase();
    var type = (document.getElementById("channel-type-filter")?.value || "all").toLowerCase();
    var cards = document.querySelectorAll(".channel-card");
    var visibleCount = 0;

    cards.forEach(function(card) {
      var name = card.getAttribute("data-name") || "";
      var dest = card.getAttribute("data-destination") || "";
      var cardType = card.getAttribute("data-type") || "";

      var matchesSearch = !search || name.includes(search) || dest.includes(search);
      var matchesType = (type === "all") || (cardType === type);

      if (matchesSearch && matchesType) {
        card.classList.remove("hidden");
        visibleCount++;
      } else {
        card.classList.add("hidden");
      }
    });

    var countBadge = document.getElementById("channels-count");
    if (countBadge) {
      countBadge.textContent = "(" + visibleCount + ")";
    }

    var noMatch = document.getElementById("no-channels-match");
    if (noMatch) {
      if (visibleCount === 0 && cards.length > 0) {
        noMatch.classList.remove("hidden");
      } else {
        noMatch.classList.add("hidden");
      }
    }
  }
</script>
