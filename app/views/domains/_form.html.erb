<%= form_with(model: domain, class: "space-y-6") do |f| %>
  <%= render 'shared/validation_errors', model: domain %>

  <%# Bloque 1: Datos Básicos %>
  <div class="bg-[#261c18]/90 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-md space-y-4 shadow-md">
    <h3 class="text-sm font-bold text-white border-b border-amber-500/20 pb-3">Parámetros del Dominio</h3>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, "Nombre del Servicio", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.text_field :name, placeholder: "ej. Mi Tienda Online", class: "w-full bg-[#1c1512] border border-amber-500/30 focus:border-amber-400 rounded-xl px-3.5 py-2 text-xs text-white placeholder-amber-200/30 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :url, "URL Completa", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.text_field :url, placeholder: "https://ejemplo.com", class: "w-full bg-[#1c1512] border border-amber-500/30 focus:border-amber-400 rounded-xl px-3.5 py-2 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
      </div>
    </div>
  </div>

  <%# Bloque 2: Reglas Avanzadas %>
  <div class="bg-[#261c18]/90 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-md space-y-4 shadow-md">
    <h3 class="text-sm font-bold text-white border-b border-amber-500/20 pb-3">Criterios de Verificación</h3>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= f.label :expected_http_code, "Código HTTP Esperado", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.number_field :expected_http_code, placeholder: "200", class: "w-full bg-[#1c1512] border border-amber-500/30 focus:border-amber-400 rounded-xl px-3.5 py-2 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
      </div>

      <div>
        <%= f.label :expected_keyword, "Palabra Clave en HTML (Opcional)", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.text_field :expected_keyword, placeholder: "ej. Bienvenido", class: "w-full bg-[#1c1512] border border-amber-500/30 focus:border-amber-400 rounded-xl px-3.5 py-2 text-xs text-white placeholder-amber-200/30 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :max_latency_threshold_ms, "Alerta de Latencia Máx (ms)", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.number_field :max_latency_threshold_ms, placeholder: "1000", class: "w-full bg-[#1c1512] border border-amber-500/30 focus:border-amber-400 rounded-xl px-3.5 py-2 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
      </div>
    </div>
  </div>

  <%# Bloque 3: Notificaciones %>
  <div class="bg-[#261c18]/90 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-md space-y-5 shadow-md">
    <div class="flex items-center justify-between border-b border-amber-500/20 pb-3">
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">Canales de Alerta</h3>
        <p class="text-xs text-amber-200/60 mt-0.5">Configura cómo y dónde recibir avisos automáticos ante caídas o lentitud.</p>
      </div>
      <%= link_to "Gestionar Canales →", notification_channels_path, class: "text-xs font-semibold text-amber-400 hover:text-amber-300" %>
    </div>

    <div class="space-y-4">
      <%# Email %>
      <% default_email_ch = current_user&.notification_channels&.by_type(:email)&.find_by(is_default: true) || current_user&.notification_channels&.by_type(:email)&.first %>
      <% email_channels = current_user&.notification_channels&.by_type(:email)&.order(is_default: :desc) %>
      <div class="p-3.5 rounded-xl bg-[#1c1512] border border-amber-500/20 space-y-3">
        <label class="flex items-center gap-3 cursor-pointer">
          <%= f.check_box :notify_email, class: "h-4 w-4 rounded border-amber-500 text-amber-500 focus:ring-amber-400",
                onchange: "if (this.checked && !document.getElementById('domain_notify_email_address').value && '#{default_email_ch&.destination}') { document.getElementById('domain_notify_email_address').value = '#{default_email_ch&.destination}'; var s = document.getElementById('domain_select_email'); if(s) s.value = '#{default_email_ch&.destination}'; }" %>
          <div>
            <span class="text-xs font-bold text-white block">Notificación por Email</span>
            <span class="text-[11px] text-amber-200/60 block">Recibe un correo ante caídas o latencias excesivas.</span>
          </div>
        </label>
        <div class="pl-7 space-y-2">
          <% if email_channels&.any? %>
            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-[11px] font-semibold text-amber-300/80">Seleccionar Canal Guardado:</label>
                <button type="button" onclick="document.getElementById('domain_notify_email_address').value=''; document.getElementById('domain_notify_email_address').focus(); var sel = document.getElementById('domain_select_email'); if(sel) sel.value = 'custom';" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-xs font-semibold transition cursor-pointer shadow-sm"><span>+ Escribir otro correo</span></button>
              </div>
              <select id="domain_select_email" onchange="if(this.value !== 'custom') document.getElementById('domain_notify_email_address').value = this.value;" class="w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none cursor-pointer">
                <option value="custom" disabled hidden>-- Escribiendo personalizado (selecciona aquí para restaurar) --</option>
                <% email_channels.each do |ch| %>
                  <option value="<%= ch.destination %>" <%= "selected" if domain.notify_email_address == ch.destination || (domain.notify_email_address.blank? && ch.is_default?) %>>
                    <%= ch.name %> (<%= ch.destination %>) <%= "★ Predeterminado" if ch.is_default? %>
                  </option>
                <% end %>
              </select>
            </div>
          <% else %>
            <div class="flex justify-end">
              <%= link_to "+ Añadir canal de correo", notification_channels_path, target: "_blank", class: "text-[10px] text-amber-400 hover:text-amber-200 underline" %>
            </div>
          <% end %>
          <div>
            <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Destino específico (opcional):</label>
            <%= f.text_field :notify_email_address, id: "domain_notify_email_address", value: (domain.notify_email_address.presence || (domain.new_record? ? default_email_ch&.destination : nil)), placeholder: "ej. usuario@ejemplo.com", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
          </div>
        </div>
      </div>

      <%# Discord %>
      <% default_discord_ch = current_user&.notification_channels&.by_type(:discord)&.find_by(is_default: true) || current_user&.notification_channels&.by_type(:discord)&.first %>
      <% discord_channels = current_user&.notification_channels&.by_type(:discord)&.order(is_default: :desc) %>
      <div class="p-3.5 rounded-xl bg-[#1c1512] border border-amber-500/20 space-y-2 <%= "opacity-60 bg-[#16100e]" unless current_user&.pro? %>">
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-3 <%= current_user&.pro? ? "cursor-pointer" : "cursor-not-allowed" %>">
            <%= f.check_box :notify_discord, disabled: !current_user&.pro?, class: "h-4 w-4 rounded border-amber-500 text-amber-500 focus:ring-amber-400 disabled:opacity-40",
                  onchange: "if (this.checked && !document.getElementById('domain_discord_webhook_url').value && '#{default_discord_ch&.destination}') { document.getElementById('domain_discord_webhook_url').value = '#{default_discord_ch&.destination}'; var s = document.getElementById('domain_select_discord'); if(s) s.value = '#{default_discord_ch&.destination}'; }" %>
            <div>
              <span class="text-xs font-bold text-white block">Alertas por Discord</span>
              <span class="text-[11px] text-amber-200/60 block">Envío automático a un canal mediante Webhook.</span>
            </div>
          </label>
          <% unless current_user&.pro? %>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
              🔒 Exclusivo Plan PRO
            </span>
          <% end %>
        </div>
        <div class="pl-7 space-y-2">
          <% if discord_channels&.any? %>
            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-[11px] font-semibold text-amber-300/80">Seleccionar Webhook Guardado:</label>
                <button type="button" onclick="document.getElementById('domain_discord_webhook_url').value=''; document.getElementById('domain_discord_webhook_url').focus(); var sel = document.getElementById('domain_select_discord'); if(sel) sel.value = 'custom';" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-xs font-semibold transition cursor-pointer shadow-sm"><span>+ Escribir otro webhook</span></button>
              </div>
              <select id="domain_select_discord" onchange="if(this.value !== 'custom') document.getElementById('domain_discord_webhook_url').value = this.value;" class="w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none cursor-pointer">
                <option value="custom" disabled hidden>-- Escribiendo personalizado (selecciona aquí para restaurar) --</option>
                <% discord_channels.each do |ch| %>
                  <option value="<%= ch.destination %>" <%= "selected" if domain.discord_webhook_url == ch.destination || (domain.discord_webhook_url.blank? && ch.is_default?) %>>
                    <%= ch.name %> <%= "★ Predeterminado" if ch.is_default? %>
                  </option>
                <% end %>
              </select>
            </div>
          <% else %>
            <div class="flex justify-end">
              <%= link_to "+ Añadir webhook Discord", notification_channels_path, target: "_blank", class: "text-[10px] text-amber-400 hover:text-amber-200 underline" %>
            </div>
          <% end %>
          <div>
            <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Webhook URL:</label>
            <%= f.text_field :discord_webhook_url, id: "domain_discord_webhook_url", value: (domain.discord_webhook_url.presence || (domain.new_record? ? default_discord_ch&.destination : nil)), placeholder: "https://discord.com/api/webhooks/...", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
          </div>
        </div>
      </div>

      <%# Telegram %>
      <% default_telegram_ch = current_user&.notification_channels&.by_type(:telegram)&.find_by(is_default: true) || current_user&.notification_channels&.by_type(:telegram)&.first %>
      <% telegram_channels = current_user&.notification_channels&.by_type(:telegram)&.order(is_default: :desc) %>
      <div class="p-3.5 rounded-xl bg-[#1c1512] border border-amber-500/20 space-y-2 <%= "opacity-60 bg-[#16100e]" unless current_user&.pro? %>">
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-3 <%= current_user&.pro? ? "cursor-pointer" : "cursor-not-allowed" %>">
            <%= f.check_box :notify_telegram, disabled: !current_user&.pro?, class: "h-4 w-4 rounded border-amber-500 text-amber-500 focus:ring-amber-400 disabled:opacity-40",
                  onchange: "if (this.checked && !document.getElementById('domain_telegram_chat_id').value && '#{default_telegram_ch&.destination}') { document.getElementById('domain_telegram_chat_id').value = '#{default_telegram_ch&.destination}'; var s = document.getElementById('domain_select_telegram'); if(s) s.value = '#{default_telegram_ch&.destination}'; }" %>
            <div>
              <span class="text-xs font-bold text-white block">Alertas por Telegram</span>
              <span class="text-[11px] text-amber-200/60 block">Notificaciones directas vía Bot de Telegram.</span>
            </div>
          </label>
          <% unless current_user&.pro? %>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
              🔒 Exclusivo Plan PRO
            </span>
          <% end %>
        </div>
        <div class="pl-7 space-y-2">
          <% if telegram_channels&.any? %>
            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-[11px] font-semibold text-amber-300/80">Seleccionar Chat Guardado:</label>
                <button type="button" onclick="document.getElementById('domain_telegram_chat_id').value=''; document.getElementById('domain_telegram_chat_id').focus(); var sel = document.getElementById('domain_select_telegram'); if(sel) sel.value = 'custom';" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-xs font-semibold transition cursor-pointer shadow-sm"><span>+ Escribir otro chat</span></button>
              </div>
              <select id="domain_select_telegram" onchange="if(this.value !== 'custom') document.getElementById('domain_telegram_chat_id').value = this.value;" class="w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none cursor-pointer">
                <option value="custom" disabled hidden>-- Escribiendo personalizado (selecciona aquí para restaurar) --</option>
                <% telegram_channels.each do |ch| %>
                  <option value="<%= ch.destination %>" <%= "selected" if domain.telegram_chat_id == ch.destination || (domain.telegram_chat_id.blank? && ch.is_default?) %>>
                    <%= ch.name %> (<%= ch.destination %>) <%= "★ Predeterminado" if ch.is_default? %>
                  </option>
                <% end %>
              </select>
            </div>
          <% else %>
            <div class="flex justify-end">
              <%= link_to "+ Añadir chat Telegram", notification_channels_path, target: "_blank", class: "text-[10px] text-amber-400 hover:text-amber-200 underline" %>
            </div>
          <% end %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Bot Token (opcional):</label>
              <%= f.text_field :telegram_bot_token, placeholder: "ej. 123456:ABC...", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Chat ID:</label>
              <%= f.text_field :telegram_chat_id, id: "domain_telegram_chat_id", value: (domain.telegram_chat_id.presence || (domain.new_record? ? default_telegram_ch&.destination : nil)), placeholder: "ej. 987654321", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Botonera %>
  <div class="flex items-center justify-end gap-3 pt-4">
    <%= link_to "Cancelar", domains_path, class: "px-4 py-2.5 rounded-xl text-xs font-semibold text-amber-200/80 hover:text-white bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 transition" %>
    <%= f.submit (domain.persisted? ? "Actualizar Dominio" : "Crear Dominio"), class: "px-6 py-2.5 rounded-xl font-bold text-xs text-stone-950 bg-gradient-to-r from-amber-400 via-amber-300 to-orange-400 hover:from-amber-300 hover:to-orange-300 shadow-lg shadow-amber-500/20 hover:scale-[1.02] transition-all cursor-pointer" %>
  </div>
<% end %>
