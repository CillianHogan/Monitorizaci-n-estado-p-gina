<div class="space-y-8" data-controller="domain-chart" data-domain-chart-data-value="<%= (@chart_data || @domain.status_histories.order(recorded_at: :desc).limit(300).reverse).to_json %>">
  
  <%# Header del Dominio %>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-amber-500/20">
    <div class="space-y-1">
      <div class="flex items-center gap-3">
        <%= link_to domains_path, class: "p-2 rounded-xl text-amber-200/70 hover:text-white bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 transition" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        <% end %>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white"><%= @domain.name %></h1>
        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md <%= @domain.status.to_s == 'up' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-300 border border-rose-500/30' %>">
          <%= @domain.status.to_s == 'up' ? 'ONLINE' : 'OFFLINE' %>
        </span>
      </div>
      <div class="flex items-center gap-2 text-xs text-amber-200/70 font-mono pl-11">
        <a href="<%= @domain.url %>" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300 transition-colors flex items-center gap-1">
          <%= @domain.url %>
          <svg class="w-3 h-3 text-amber-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <%# Botonera de acciones %>
    <div class="flex flex-wrap items-center gap-2">
      <%# Boton Exportar CSV %>
      <% if current_user&.pro? %>
        <%= link_to export_csv_domain_path(@domain), class: "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-amber-100 hover:text-white bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/30 transition shadow-sm" do %>
          <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <span>Exportar CSV</span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-stone-500 bg-stone-900/60 border border-stone-800 cursor-not-allowed select-none" title="Función exclusiva del Plan PRO">
          <svg class="w-4 h-4 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span>Exportar CSV</span>
        </span>
      <% end %>

      <%# Boton Comprobar ahora %>
      <% if current_user&.pro? %>
        <%= button_to check_status_domain_path(@domain), method: :post, class: "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-amber-100 hover:text-white bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/30 transition cursor-pointer shadow-sm" do %>
          <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Comprobar ahora</span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-stone-500 bg-stone-900/60 border border-stone-800 cursor-not-allowed select-none" title="Función exclusiva del Plan PRO">
          <svg class="w-4 h-4 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span>Comprobar ahora</span>
        </span>
      <% end %>

      <%= link_to edit_domain_path(@domain), class: "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-stone-950 bg-gradient-to-r from-amber-400 to-orange-400 hover:from-amber-300 hover:to-orange-300 shadow-md transition" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>Editar</span>
      <% end %>
    </div>
  </div>

  <%# Tarjetas de KPIs %>
  <% latency = @domain.respond_to?(:last_response_time_ms) && @domain.last_response_time_ms.present? ? @domain.last_response_time_ms : (@domain.status_histories.last&.response_time_ms) %>
  <% days_ssl = @domain.respond_to?(:ssl_days_remaining) ? @domain.ssl_days_remaining : (@domain.ssl_expires_at ? ((@domain.ssl_expires_at.to_date - Date.current).to_i) : nil) %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm">
      <div class="text-xs font-semibold text-amber-200/70 uppercase tracking-wider">Latencia Actual</div>
      <div class="mt-2 text-2xl font-black text-white font-mono flex items-baseline gap-2">
        <span><%= latency.present? ? latency : "—" %></span>
        <span class="text-xs font-normal text-amber-200/60 font-sans">milisegundos</span>
      </div>
    </div>

    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm">
      <div class="text-xs font-semibold text-amber-200/70 uppercase tracking-wider">Certificado SSL</div>
      <div class="mt-2 text-2xl font-black font-mono flex items-baseline gap-2 <%= days_ssl && days_ssl <= 15 ? 'text-amber-400' : 'text-emerald-300' %>">
        <span><%= days_ssl.present? ? "#{days_ssl} días" : "Sin SSL" %></span>
        <% if @domain.ssl_issuer.present? %>
          <span class="text-xs font-normal text-amber-200/60 truncate font-sans">(<%= @domain.ssl_issuer %>)</span>
        <% end %>
      </div>
    </div>

    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm">
      <div class="text-xs font-semibold text-amber-200/70 uppercase tracking-wider">Canales de Alerta</div>
      <div class="mt-2 flex items-center gap-2 flex-wrap">
        <span class="px-2 py-1 rounded text-xs font-mono font-medium <%= @domain.notify_email? ? 'bg-amber-500/30 text-amber-200 border border-amber-500/30' : 'bg-black/20 text-amber-200/30' %>">Email</span>
        <span class="px-2 py-1 rounded text-xs font-mono font-medium <%= @domain.notify_discord? ? 'bg-indigo-500/30 text-indigo-200 border border-indigo-500/30' : 'bg-black/20 text-amber-200/30' %>">Discord</span>
        <span class="px-2 py-1 rounded text-xs font-mono font-medium <%= @domain.notify_telegram? ? 'bg-sky-500/30 text-sky-200 border border-sky-500/30' : 'bg-black/20 text-amber-200/30' %>">Telegram</span>
      </div>
    </div>
  </div>

  <%# Gráfica de Historial %>
  <div class="bg-[#261c18]/90 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-md shadow-lg space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-white">Historial de Rendimiento</h2>
        <p class="text-xs text-amber-200/70">Métricas de respuesta de los últimos chequeos</p>
      </div>

      <div>
        <select data-action="change->domain-chart#changeTimeRange" class="bg-[#1c1512] text-amber-100 border border-amber-500/30 rounded-xl px-3 py-1.5 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-amber-400">
          <option value="all">Todo el historial</option>
          <option value="week">Última semana</option>
          <option value="month">Último mes</option>
          <option value="3months">Últimos 3 meses</option>
          <option value="year">Último año</option>
        </select>
      </div>
    </div>

    <div class="relative w-full h-72 pt-4">
      <canvas id="domainStatusChart" class="w-full h-full"></canvas>
    </div>
  </div>

  <%# Timeline de Incidentes y Eventos Recientes %>
  <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-sm shadow-xl">
    <div class="flex items-center justify-between pb-4 border-b border-stone-800">
      <div class="flex items-center gap-2.5">
        <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
        <h3 class="text-sm font-bold tracking-wide text-white uppercase">Registro de Incidentes y Eventos</h3>
      </div>
      <span class="text-xs font-medium text-stone-400">Últimos cambios de estado</span>
    </div>

    <% incidents = @domain.recent_incidents %>
    <% if incidents.any? %>
      <div class="mt-4 flow-root">
        <ul role="list" class="-mb-6">
          <% incidents.each_with_index do |incident, idx| %>
            <li>
              <div class="relative pb-6">
                <% unless idx == incidents.size - 1 %>
                  <span class="absolute top-4 left-3.5 -ml-px h-full w-0.5 bg-stone-800" aria-hidden="true"></span>
                <% end %>
                <div class="relative flex items-start space-x-3">
                  <% if incident[:status] == "up" %>
                    <div class="relative px-1">
                      <div class="h-6 w-6 bg-emerald-500/10 border border-emerald-500/40 rounded-full flex items-center justify-center ring-4 ring-[#241a16]">
                        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                      </div>
                    </div>
                    <div class="min-w-0 flex-1 py-0.5">
                      <div class="text-xs font-semibold text-emerald-400 flex items-center gap-2">
                        <span>Servicio Recuperado (UP)</span>
                        <% if incident[:http_code].present? %>
                          <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono text-[10px]">HTTP <%= incident[:http_code] %></span>
                        <% end %>
                        <% if incident[:response_time_ms].present? %>
                          <span class="text-stone-400 font-normal"><%= incident[:response_time_ms] %> ms</span>
                        <% end %>
                      </div>
                      <p class="mt-0.5 text-xs text-stone-400">
                        El dominio volvió a responder con éxito tras estar en estado <%= incident[:previous_status].to_s.upcase %>.
                      </p>
                    </div>
                  <% else %>
                    <div class="relative px-1">
                      <div class="h-6 w-6 bg-rose-500/10 border border-rose-500/40 rounded-full flex items-center justify-center ring-4 ring-[#241a16]">
                        <span class="h-2 w-2 rounded-full bg-rose-400"></span>
                      </div>
                    </div>
                    <div class="min-w-0 flex-1 py-0.5">
                      <div class="text-xs font-semibold text-rose-400 flex items-center gap-2">
                        <span>Caída Detectada (<%= incident[:status].to_s.upcase %>)</span>
                        <% if incident[:http_code].present? %>
                          <span class="px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 font-mono text-[10px]">HTTP <%= incident[:http_code] %></span>
                        <% end %>
                      </div>
                      <p class="mt-0.5 text-xs text-stone-400">
                        Se registró un fallo de respuesta en el chequeo periódico.
                      </p>
                    </div>
                  <% end %>
                  <div class="text-right text-xs whitespace-nowrap text-stone-400 font-mono">
                    <time><%= incident[:recorded_at]&.strftime("%d/%m %H:%M") %></time>
                  </div>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="mt-4 py-6 text-center border border-dashed border-stone-800 rounded-xl bg-stone-900/30">
        <svg class="mx-auto h-8 w-8 text-emerald-400/80 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-xs font-medium text-emerald-400">Sin incidentes recientes</p>
        <p class="text-[11px] text-stone-400 mt-0.5">El monitor no ha registrado caídas en las últimas muestras analizadas.</p>
      </div>
    <% end %>
  </div>

  <%# Enlace a Status Page Pública con botón copiar %>
  <% if @domain.public_token.present? %>
    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h3 class="text-sm font-bold text-white">Página Pública de Estado</h3>
        <p class="text-xs text-amber-200/70">Comparte este enlace con tus clientes o equipo para que vean el estado sin necesidad de iniciar sesión.</p>
      </div>

      <div class="flex items-center gap-2">
        <input id="public-status-url-input" type="text" readonly value="<%= public_status_url(@domain.public_token) %>" class="bg-[#1a1310] border border-amber-500/30 rounded-xl px-3 py-1.5 text-xs text-amber-200 font-mono w-56 sm:w-64 focus:outline-none select-all">
        <button type="button" id="copy-status-btn" onclick="copyPublicStatusLink(this)" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-stone-950 bg-amber-400 hover:bg-amber-300 shadow transition cursor-pointer flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 icon-copy" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span class="btn-text">Copiar enlace</span>
        </button>

        <%= link_to public_status_url(@domain.public_token), target: "_blank", rel: "noopener noreferrer", class: "px-3.5 py-1.5 rounded-xl text-xs font-bold text-amber-300 border border-amber-500/40 hover:bg-amber-500/10 transition inline-flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
          Ver
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        <% end %>
      </div>

      <script>
        function copyPublicStatusLink(btn) {
          const input = document.getElementById('public-status-url-input');
          if (!input) return;
          const urlText = input.value;

          function showSuccess() {
            const spanText = btn.querySelector('.btn-text');
            const originalBg = btn.className;
            btn.classList.remove('bg-amber-400', 'hover:bg-amber-300', 'text-stone-950');
            btn.classList.add('bg-emerald-500', 'hover:bg-emerald-400', 'text-white');
            if (spanText) spanText.textContent = '¡Copiado! ✓';

            setTimeout(() => {
              btn.className = originalBg;
              if (spanText) spanText.textContent = 'Copiar enlace';
            }, 2000);
          }

          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(urlText).then(showSuccess).catch(() => {
              input.select();
              document.execCommand('copy');
              showSuccess();
            });
          } else {
            input.select();
            document.execCommand('copy');
            showSuccess();
          }
        }
      </script>
    </div>
  <% end %>

</div>
