<div class="space-y-8" data-controller="domain-chart" data-domain-chart-data-value="<%= (@chart_data || @domain.status_histories.order(recorded_at: :desc).limit(300).reverse).to_json %>">
  
  <%# Barra superior del dominio %>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-amber-500/20">
    <div class="space-y-1">
      <div class="flex items-center gap-3">
        <%= link_to domains_path, class: "p-2 rounded-xl text-amber-200/70 hover:text-white bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 transition" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        <% end %>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white"><%= @domain.name %></h1>
        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md <%= @domain.status == 'up' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-300 border border-rose-500/30' %>">
          <%= @domain.status == 'up' ? 'ONLINE' : 'CAÍDO' %>
        </span>
      </div>
      <div class="flex items-center gap-2 text-xs text-amber-200/70 font-mono pl-11">
        <a href="<%= @domain.url %>" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300 flex items-center gap-1 transition">
          <%= @domain.url %>
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= button_to check_now_domain_path(@domain), method: :post, class: "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-amber-100 hover:text-white bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/30 transition cursor-pointer" do %>
        <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Comprobar ahora</span>
      <% end %>

      <%= link_to edit_domain_path(@domain), class: "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-stone-950 bg-gradient-to-r from-amber-400 to-orange-400 hover:from-amber-300 hover:to-orange-300 shadow-md transition" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>Editar</span>
      <% end %>
    </div>
  </div>

  <%# Tarjetas de KPIs %>
  <% latency = @domain.respond_to?(:last_response_time_ms) && @domain.last_response_time_ms.present? ? @domain.last_response_time_ms : (@domain.status_histories.last&.response_time_ms) %>
  <% days_ssl = @domain.respond_to?(:ssl_days_remaining) ? @domain.ssl_days_remaining : (@domain.ssl_expires_at ? ((@domain.ssl_expires_at.to_date - Date.current).to_i) : nil) %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm">
      <div class="text-xs font-semibold text-amber-200/70 uppercase tracking-wider">Latencia Actual</div>
      <div class="mt-2 text-2xl font-black text-white font-mono flex items-baseline gap-2">
        <span><%= latency.present? ? latency : "—" %></span>
        <span class="text-xs font-normal text-amber-200/60 font-sans">milisegundos</span>
      </div>
    </div>

    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm">
      <div class="text-xs font-semibold text-amber-200/70 uppercase tracking-wider">Certificado SSL</div>
      <div class="mt-2 text-2xl font-black font-mono flex items-baseline gap-2 <%= days_ssl && days_ssl <= 15 ? 'text-amber-400' : 'text-emerald-300' %>">
        <span><%= days_ssl.present? ? "#{days_ssl} días" : "Sin SSL" %></span>
        <% if @domain.ssl_issuer.present? %>
          <span class="text-xs font-normal text-amber-200/60 truncate font-sans">(<%= @domain.ssl_issuer %>)</span>
        <% end %>
      </div>
    </div>

    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm">
      <div class="text-xs font-semibold text-amber-200/70 uppercase tracking-wider">Canales de Alerta</div>
      <div class="mt-2 flex items-center gap-2 flex-wrap">
        <span class="px-2 py-1 rounded text-xs font-mono font-medium <%= @domain.notify_email? ? 'bg-amber-500/30 text-amber-200 border border-amber-500/30' : 'bg-black/20 text-amber-200/30' %>">Email</span>
        <span class="px-2 py-1 rounded text-xs font-mono font-medium <%= @domain.notify_discord? ? 'bg-indigo-500/30 text-indigo-200 border border-indigo-500/30' : 'bg-black/20 text-amber-200/30' %>">Discord</span>
        <span class="px-2 py-1 rounded text-xs font-mono font-medium <%= @domain.notify_telegram? ? 'bg-sky-500/30 text-sky-200 border border-sky-500/30' : 'bg-black/20 text-amber-200/30' %>">Telegram</span>
      </div>
    </div>
  </div>

  <%# Gráfica de Historial %>
  <div class="bg-[#261c18]/90 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-md shadow-lg space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-white">Historial de Rendimiento</h2>
        <p class="text-xs text-amber-200/70">Métricas de respuesta de los últimos chequeos</p>
      </div>

      <div>
        <select data-action="change->domain-chart#changeTimeRange" class="bg-[#1c1512] text-amber-100 border border-amber-500/30 rounded-xl px-3 py-1.5 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-amber-400">
          <option value="all">Todo el historial</option>
          <option value="week">Última semana</option>
          <option value="month">Último mes</option>
          <option value="3months">Últimos 3 meses</option>
          <option value="year">Último año</option>
        </select>
      </div>
    </div>

    <div class="relative w-full h-72 pt-4">
      <canvas id="domainStatusChart" class="w-full h-full"></canvas>
    </div>
  </div>

  <%# Enlace a Status Page Pública con botón copiar %>
  <% if @domain.public_token.present? %>
    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h3 class="text-sm font-bold text-white">Página Pública de Estado</h3>
        <p class="text-xs text-amber-200/70">Comparte este enlace con tus clientes o equipo para que vean el estado sin necesidad de iniciar sesión.</p>
      </div>

      <div class="flex items-center gap-2" data-controller="clipboard" data-clipboard-text-value="<%= public_status_url(@domain.public_token) %>">
        <input type="text" readonly value="<%= public_status_url(@domain.public_token) %>" class="bg-[#1a1310] border border-amber-500/30 rounded-xl px-3 py-1.5 text-xs text-amber-200 font-mono w-64 focus:outline-none">
        <button type="button" data-action="click->clipboard#copy" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-stone-950 bg-amber-400 hover:bg-amber-300 shadow transition cursor-pointer">
          Copiar
        </button>
      </div>
    </div>
  <% end %>

</div>
