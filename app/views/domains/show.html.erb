<div class="container">
  <div class="bg-white shadow-lg rounded-lg overflow-hidden border border-gray-100">
    <div class="px-4 py-5 sm:px-6 bg-gradient-to-r from-indigo-50 to-blue-50">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-indigo-800"><%= @domain.name %></h1>
        </div>
        <div class="flex items-center gap-2 sm:hidden">
          <span class="inline-flex items-center px-4 py-2 rounded-lg text-base font-semibold shadow-sm <%= @domain.status_up? ? 'bg-green-100 text-green-800 ring-1 ring-green-500/20' : (@domain.status_error? ? 'bg-red-100 text-red-800 ring-1 ring-red-500/20' : 'bg-amber-100 text-amber-800 ring-1 ring-amber-500/20') %>">
            <% case @domain.status %>
            <% when 'up' %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <% when 'error' %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <% else %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <% end %>
            <%= @domain.status.titleize %>
          </span>
        </div>
      </div>
      <p class="mt-1 max-w-2xl text-sm text-gray-600">Detalles de monitorización del dominio</p>
    </div>
    <div class="border-t border-gray-200">
      <div class="flex">
        <dl class="flex-grow">
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-600">URL</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2">
              <%= link_to @domain.url, @domain.url, target: '_blank', class: 'text-blue-600 hover:text-blue-800 underline' %>
            </dd>
          </div>
          <div class="bg-gradient-to-r from-indigo-50 to-blue-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-600">Última latencia registrada</dt>
            <dd class="mt-1 text-sm sm:col-span-2 flex items-center gap-2">
              <% last_history = @domain.status_histories.order(recorded_at: :desc).first %>
              <% if last_history&.response_time_ms.present? %>
                <span class="text-lg font-bold text-indigo-700"><%= last_history.response_time_ms %> ms</span>
                <%= http_code_badge(last_history.http_code) %>
                <% if last_history.response_time_ms < 300 %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Rápido</span>
                <% elsif last_history.response_time_ms < 1000 %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">Normal</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">Lento</span>
                <% end %>
              <% else %>
                <span class="text-gray-500">Pendiente de registro</span>
              <% end %>
            </dd>
          </div>
          <% if @domain.expected_keyword.present? %>
          <div class="bg-white px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 border-b border-gray-100">
            <dt class="text-sm font-medium text-gray-600">Palabra requerida</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 font-mono bg-gray-50 px-2 py-1 rounded inline-block">
              <%= @domain.expected_keyword %>
            </dd>
          </div>
          <% end %>
          <div class="bg-white px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 border-b border-gray-100">
            <dt class="text-sm font-medium text-gray-600">Umbral de alerta</dt>
            <dd class="mt-1 text-sm text-gray-700 sm:col-span-2">
              <%= @domain.max_latency_threshold_ms || 2000 %> ms
            </dd>
          </div>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-600">Última actualización</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2">
              <%= @domain.updated_at.strftime("%B %d, %Y a las %I:%M %p") %>
            </dd>
          </div>
        </dl>
        <div class="sm:flex items-center justify-center py-6 w-64 border-l border-gray-200 hidden">
          <div class="text-center">
            <div class="mb-4">
              <div class="inline-flex items-center justify-center w-24 h-24 rounded-full <%= @domain.status_up? ? 'bg-green-100' : (@domain.status_error? ? 'bg-red-100' : 'bg-amber-100') %>">
                <% case @domain.status %>
                <% when 'up' %>
                  <svg class="w-12 h-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <% when 'error' %>
                  <svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <% else %>
                  <svg class="w-12 h-12 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <% end %>
              </div>
            </div>
            <h2 class="text-xl font-bold <%= @domain.status_up? ? 'text-green-600' : (@domain.status_error? ? 'text-red-600' : 'text-amber-600') %>">
              <%= @domain.status.titleize %>
            </h2>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Tarjeta de Estado del Certificado SSL %>
  <div class="mt-8 bg-white shadow-lg rounded-lg overflow-hidden border border-gray-100">
    <div class="px-4 py-5 sm:px-6 bg-gradient-to-r from-indigo-50 to-blue-50 flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold text-indigo-800">Certificado SSL / HTTPS</h2>
        <p class="mt-1 text-sm text-gray-600">Información de seguridad y vigencia del cifrado</p>
      </div>
      <div>
        <% if @domain.respond_to?(:ssl_valid) && @domain.ssl_valid? %>
          <% if @domain.ssl_days_remaining.to_i <= 30 %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 ring-1 ring-amber-500/20">
              Próximo a caducar
            </span>
          <% else %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 ring-1 ring-green-500/20">
              Certificado Válido
            </span>
          <% end %>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800 ring-1 ring-red-500/20">
            Sin HTTPS / No Válido
          </span>
        <% end %>
      </div>
    </div>
    <div class="border-t border-gray-200">
      <dl>
        <div class="bg-white px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-600">Emisor (Authority)</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2">
            <%= @domain.try(:ssl_issuer).presence || 'No disponible' %>
          </dd>
        </div>
        <div class="bg-gradient-to-r from-indigo-50 to-blue-50 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-600">Fecha de expiración</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2">
            <%= @domain.try(:ssl_expires_at)&.strftime("%B %d, %Y (%I:%M %p)") || 'No disponible' %>
          </dd>
        </div>
        <div class="bg-white px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-600">Días restantes</dt>
          <dd class="mt-1 text-sm font-semibold sm:col-span-2 <%= @domain.try(:ssl_days_remaining).to_i <= 30 ? 'text-amber-600' : 'text-green-600' %>">
            <%= @domain.try(:ssl_days_remaining).present? ? "#{@domain.ssl_days_remaining} días" : 'Desconocido' %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <%# Gráfica de Latencia e Historial %>
  <div class="mt-8 bg-white shadow-lg rounded-lg overflow-hidden border border-gray-100" data-controller="domain-chart" data-domain-chart-data-value="<%= (@chart_data || @domain.status_histories.order(recorded_at: :desc).limit(300).reverse).to_json %>">
    <div class="px-4 py-5 sm:px-6 bg-gradient-to-r from-indigo-50 to-blue-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold text-indigo-800">Historial y Latencia (ms)</h2>
        <p class="mt-1 text-sm text-gray-600">Tiempo de respuesta y estado en cada verificación</p>
      </div>
      <div class="w-full sm:w-48">
        <select data-action="change->domain-chart#changeTimeRange" class="block w-full pl-3 pr-8 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
          <option value="all">Todo el historial</option>
          <option value="week">Última semana</option>
          <option value="month">Último mes</option>
          <option value="3months">Últimos 3 meses</option>
          <option value="year">Último año</option>
        </select>
      </div>
    </div>
    <div class="p-6 overflow-x-auto">
      <div class="w-full h-[280px] sm:h-[320px]">
        <canvas id="domainStatusChart" class="w-full h-full"></canvas>
      </div>
    </div>
  </div>

  <%# Página de estado pública %>
  <div class="mt-8 bg-white shadow-lg rounded-lg overflow-hidden border border-gray-100">
    <div class="px-4 py-5 sm:px-6 bg-gradient-to-r from-indigo-50 to-blue-50">
      <h2 class="text-xl font-semibold text-indigo-800">Página de estado pública</h2>
      <p class="mt-1 text-sm text-gray-600">Comparte esta URL para mostrar el estado de tu dominio públicamente</p>
    </div>
    <div class="p-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4" data-controller="clipboard">
        <div class="flex-grow">
          <div class="relative rounded-md shadow-sm">
            <input type="text" readonly value="<%= public_status_url(@domain.public_token) %>" class="block w-full pr-10 border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" id="public-status-url">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
              <button data-action="click->clipboard#copy" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M8 2a1 1 0 000 2h2a1 1 0 100-2H8z" />
                  <path d="M3 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v6h-4.586l1.293-1.293a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L10.414 13H15v3a2 2 0 01-2 2H5a2 2 0 01-2-2V5zM15 11h2a1 1 0 110 2h-2v-2z" />
                </svg>
              </button>
            </div>
          </div>
          <p class="mt-2 text-xs text-gray-500">Esta URL permite a cualquier persona ver el estado de tu dominio sin necesidad de iniciar sesión</p>
        </div>
        <div>
          <%= link_to 'Ver página pública', public_status_path(@domain.public_token), target: '_blank', class: 'inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 flex justify-end space-x-3">
    <%= link_to 'Edit', edit_domain_path(@domain), class: 'inline-flex items-center px-4 py-2 border border-indigo-300 shadow-sm text-sm font-medium rounded-md text-indigo-700 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
    <%= button_to 'Delete', domain_path(@domain), method: :delete, class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500', form: { data: { turbo_confirm: 'Are you sure?' } } %>
    <%= link_to 'Back to Domains', domains_path, class: 'inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
  </div>
</div>
