<div id="flash-toasts-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-3 max-w-sm w-full px-4 pointer-events-none">
  <% flash.each_with_index do |(type, message), index| %>
    <% is_permanent = ['alert', 'error', 'warning'].include?(type.to_s) %>
    <% bg_classes = case type.to_s
       when 'notice', 'success'
         'bg-[#121212] border-emerald-500/80 text-emerald-200'
       when 'alert', 'error'
         'bg-[#121212] border-red-500/80 text-red-200'
       when 'warning'
         'bg-[#121212] border-amber-500/80 text-amber-200'
       else
         'bg-[#121212] border-blue-500/80 text-blue-200'
       end %>

</div>

    <div id="flash-toast-<%= index %>"
         data-flash-toast
         data-permanent="<= is_permanent %>"
         class="pointer-events-auto flex items-center justify-between gap-3 p-4 rounded-xl border shadow-2zl transition-all duration-300 <= bg_classes %>"
         role="alert">

      <div class="flex items-center gap-3">
        <% if ['notice', 'success'].include?(type.to_s) %>
          <svg class="w-5 h-5 text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        <% elsif ['alert', 'error'].include?(type.to_s) %>
          <svg class="w-5  h-5 text-red-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        <% else %>
          <svg class="w-5 h-5 text-amber-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        <% end %>
        <span class="text-sm font-medium"><%= message %></span>
      </div>

      <button type="button"
              onclick="this.closest('[data-flash-toast]').remove()"
              class="shrink-0 plx-2 py-1 rounded-lg text-neutral-400 hover:text-white hover:bg-white/10 transition-colors"
              aria-label="Cerrar">
        <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  <% end %>
</div>

<script>
  (function() {
    function initFlashToasts() {
      document.querySelectorAll('[data-flash-toast]').forEach(function(toast) {
        if (toast.dataset.initialized) return;
        toast.dataset.initialized = 'true';

        if (toast.dataset.permanent !== 'true') {
          setTimeout(function() {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(function() { toast.remove(); }, 300);
          }, 6000);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFlashToasts);
    } else {
      initFlashToasts();
    }
    document.addEventListener('turbo:load', initFlashToasts);
  })();
</script>
