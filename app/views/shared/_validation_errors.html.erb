<%# Parcial para mostrar errores de validación de modelos de forma consistente %>
<% if model.errors.any? %>
  <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-3 rounded-md mb-4 shadow-sm animate-fade-in">
    <div class="flex items-start">
      <div class="mr-3 flex-shrink-0 pt-0.5">
        <svg class="h-5 w-5 text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-medium text-red-800">
          <%= pluralize(model.errors.count, "error") %> <%= error_message || "prohibited this #{model.class.name.downcase} from being saved:" %>
        </h2>
        <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
          <% model.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>