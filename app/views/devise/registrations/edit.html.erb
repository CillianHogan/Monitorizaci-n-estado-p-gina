<div class="max-w-2xl mx-auto px-4 py-8">
  <!-- Botón Volver Atrás -->
  <div class="mb-6">
    <%= link_to domains_path, class: "inline-flex items-center text-sm font-medium text-amber-500 hover:text-amber-400 transition-colors" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Volver al panel principal
    <% end %>
  </div>

  <!-- Tarjeta Principal del Perfil -->
  <div class="bg-[#18120c]/90 border border-amber-900/30 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-md">
    <div class="border-b border-amber-900/20 pb-5 mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-amber-100">Mi Perfil</h2>
      <p class="text-sm text-amber-200/60 mt-1">Administra tu información personal y credenciales de acceso.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Campo Email -->
      <div>
        <%= f.label :email, "Correo Electrónico", class: "block text-xs font-semibold uppercase tracking-wider text-amber-300/80 mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2.5 rounded-xl bg-black/40 border border-amber-900/40 text-amber-100 placeholder-amber-900/50 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="p-3 rounded-lg bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300">
          Esperando confirmación para: <%= resource.unconfirmed_email %>
        </div>
      <% end %>

      <!-- Nueva Contraseña -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <%= f.label :password, "Nueva Contraseña", class: "text-xs font-semibold uppercase tracking-wider text-amber-300/80" %>
          <span class="text-xs text-amber-200/40">(Dejar en blanco si no deseas cambiarla)</span>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2.5 rounded-xl bg-black/40 border border-amber-900/40 text-amber-100 placeholder-amber-900/50 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm" %>
        <% if @minimum_password_length %>
          <span class="text-[11px] text-amber-200/40 mt-1 block">Mínimo <%= @minimum_password_length %> caracteres.</span>
        <% end %>
      </div>

      <!-- Confirmar Nueva Contraseña -->
      <div>
        <%= f.label :password_confirmation, "Confirmar Nueva Contraseña", class: "block text-xs font-semibold uppercase tracking-wider text-amber-300/80 mb-2" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2.5 rounded-xl bg-black/40 border border-amber-900/40 text-amber-100 placeholder-amber-900/50 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm" %>
      </div>

      <!-- Contraseña Actual -->
      <div class="pt-4 border-t border-amber-900/20">
        <div class="mb-2">
          <%= f.label :current_password, "Contraseña Actual", class: "text-xs font-semibold uppercase tracking-wider text-amber-300/80" %>
          <span class="text-xs text-amber-200/40 block mt-0.5">Necesaria para autorizar cualquier modificación.</span>
        </div>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-2.5 rounded-xl bg-black/40 border border-amber-900/40 text-amber-100 placeholder-amber-900/50 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm" %>
      </div>

      <!-- Botón de Acción -->
      <div class="pt-2 flex justify-end">
        <%= f.submit "Guardar Cambios", class: "px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-semibold text-sm shadow-lg shadow-amber-500/20 transition-all cursor-pointer" %>
      </div>
    <% end %>

    <!-- Zona de Peligro / Cancelar Cuenta -->
    <div class="mt-10 pt-6 border-t border-red-900/30 flex items-center justify-between">
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-red-400">Eliminar cuenta</h4>
        <p class="text-xs text-red-300/50">Esta acción borrará tus credenciales y no se puede deshacer.</p>
      </div>
      <%= button_to "Eliminar mi cuenta", registration_path(resource_name), data: { confirm: "¿Estás seguro de que deseas eliminar tu cuenta?", turbo_confirm: "¿Estás seguro de que deseas eliminar tu cuenta?" }, method: :delete, class: "text-xs font-medium text-red-400 hover:text-red-300 hover:underline transition-colors" %>
    </div>
  </div>
</div>
