<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-sm p-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Mi Perfil</h1>
      <p class="mt-2 text-gray-600">Administra tu información personal y configuración de cuenta.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <div class="mb-4">
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autocomplete: "email", class: "mt-1 block w-full px-4 py-3 rounded-lg border border-gray-200 shadow-sm hover:border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm transition-all duration-200" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="text-sm text-yellow-600 mb-4">
            Esperando confirmación para: <%= resource.unconfirmed_email %>
          </div>
        <% end %>

        <div class="mb-4">
          <%= f.label :password, "Nueva Contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full px-4 py-3 rounded-lg border border-gray-200 shadow-sm hover:border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm transition-all duration-200" %>
          <p class="mt-1 text-sm text-gray-500">Dejar en blanco si no deseas cambiarla</p>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "Confirmar Nueva Contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full px-4 py-3 rounded-lg border border-gray-200 shadow-sm hover:border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm transition-all duration-200" %>
        </div>

        <div class="mb-4">
          <%= f.label :current_password, "Contraseña Actual", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "mt-1 block w-full px-4 py-3 rounded-lg border border-gray-200 shadow-sm hover:border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm transition-all duration-200" %>
          <p class="mt-1 text-sm text-gray-500">Necesitamos tu contraseña actual para confirmar los cambios</p>
        </div>
      </div>

      <div class="mt-8 flex items-center justify-between">
        <div>
          <%= button_to "Eliminar mi cuenta", registration_path(resource_name), 
              data: { confirm: "¿Estás seguro? Esta acción no se puede deshacer." }, 
              method: :delete, 
              class: "text-sm text-red-600 hover:text-red-500" %>
        </div>
        <%= f.submit "Actualizar Perfil", class: "ml-3 inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>