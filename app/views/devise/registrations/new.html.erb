<div class="min-h-[75vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md space-y-8 bg-[#18110e]/90 border border-amber-500/20 p-8 sm:p-10 rounded-3xl shadow-2xl backdrop-blur-md">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-semibold">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Acceso Gratuito
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Crea tu cuenta</h2>
      <p class="text-xs text-amber-200/60">Comienza a monitorizar tus dominios y APIs hoy mismo.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }, html: { class: "mt-6 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-1.5 text-left">
        <%= f.label :email, "Correo electrónico", class: "block text-xs font-bold uppercase tracking-wider text-amber-300/80" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "tu@empresa.com", class: "w-full px-4 py-2.5 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white placeholder-amber-200/30 text-sm focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition" %>
      </div>

      <div class="space-y-1.5 text-left">
        <div class="flex items-center justify-between">
          <%= f.label :password, "Contraseña", class: "block text-xs font-bold uppercase tracking-wider text-amber-300/80" %>
          <% if @minimum_password_length %>
            <span class="text-[11px] text-amber-200/50">(mín. <%= @minimum_password_length %> caracteres)</span>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "w-full px-4 py-2.5 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white placeholder-amber-200/30 text-sm focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition" %>
      </div>

      <div class="space-y-1.5 text-left">
        <%= f.label :password_confirmation, "Confirmar contraseña", class: "block text-xs font-bold uppercase tracking-wider text-amber-300/80" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "w-full px-4 py-2.5 rounded-xl bg-[#0d0905] border border-amber-800/50 text-white placeholder-amber-200/30 text-sm focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 transition" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Crear Cuenta", class: "w-full py-3 rounded-xl font-bold text-sm text-stone-950 bg-gradient-to-r from-amber-400 via-amber-300 to-orange-400 hover:from-amber-300 hover:to-orange-300 shadow-lg shadow-amber-500/25 hover:scale-[1.01] transition-all cursor-pointer" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-amber-500/10 text-center text-xs text-amber-200/60">
      ¿Ya tienes una cuenta?
      <%= link_to "Iniciar Sesión", new_session_path(resource_name), class: "font-semibold text-amber-400 hover:text-amber-300 underline ml-1" %>
    </div>
  </div>
</div>
