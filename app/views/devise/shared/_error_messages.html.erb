<% if resource.errors.any? %>
  <div id="error_explanation" class="rounded-xl border border-red-500/40 bg-red-950/40 p-4 mb-6">
    <div class="flex items-start gap-3">
      <div class="text-red-400 font-bold text-sm">
        El formulario contiene errores:
      </div>
    </div>
    <ul class="mt-2 text-xs text-red-300 list-disc list-inside">
      <% resource.errors.objects.each do |error| %>
        <li><%= error.attribute %>: <%= error.message rescue "error de validación" %></li>
      <% end %>
    </ul>
  </div>
<% end %>
