<div class="min-h-[80vh] flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
    <div class="inline-flex p-3 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 mb-4 shadow-inner">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>
    <h2 class="text-3xl font-extrabold text-white tracking-tight">Bienvenido de nuevo</h2>
    <p class="mt-2 text-sm text-amber-200/60">Accede a tu panel de control de monitorización</p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-[#1e1613]/80 backdrop-blur-md py-8 px-6 sm:px-10 border border-amber-500/20 rounded-3xl shadow-2xl relative overflow-hidden">
      <!-- Glow decorativo superior -->
      <div class="absolute -top-12 -right-12 w-28 h-28 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <div>
          <%= f.label :email, "Correo electrónico", class: "block text-xs font-bold uppercase tracking-wider text-amber-200/80 mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "tu@empresa.com", class: "w-full px-4 py-3 rounded-xl bg-black/40 border border-amber-500/20 text-white placeholder-amber-200/30 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition text-sm font-medium" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, "Contraseña", class: "block text-xs font-bold uppercase tracking-wider text-amber-200/80" %>
            <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
              <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-xs font-medium text-amber-400 hover:text-amber-300 transition" %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", class: "w-full px-4 py-3 rounded-xl bg-black/40 border border-amber-500/20 text-white placeholder-amber-200/30 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition text-sm font-medium" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded bg-black/40 border-amber-500/30 text-amber-500 focus:ring-amber-500/40 focus:ring-offset-0 transition cursor-pointer" %>
            <%= f.label :remember_me, "Recordar mi sesión", class: "ml-2.5 block text-xs font-medium text-amber-200/70 cursor-pointer" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Iniciar Sesión", class: "w-full flex justify-center py-3 px-4 rounded-xl text-sm font-bold text-black bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-500/50 shadow-lg shadow-amber-500/20 transition cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 pt-6 border-t border-amber-500/10 text-center">
        <p class="text-xs text-amber-200/60">
          ¿No tienes una cuenta aún?
          <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
            <%= link_to "Crear una cuenta gratis", new_registration_path(resource_name), class: "font-bold text-amber-400 hover:text-amber-300 ml-1 transition" %>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</div>
