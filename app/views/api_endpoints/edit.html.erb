<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Editar Endpoint API</h1>
      <p class="text-xs text-amber-200/60 mt-0.5"><%= @api_endpoint.name %></p>
    </div>
    <%= link_to "← Volver al Endpoint", api_endpoint_path(@api_endpoint), class: "text-xs font-semibold text-amber-400 hover:text-amber-300 transition" %>
  </div>

  <%= render "form", api_endpoint: @api_endpoint %>
</div>