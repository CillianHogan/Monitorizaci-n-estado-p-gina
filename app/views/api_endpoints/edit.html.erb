<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to api_endpoints_path, class: "inline-flex items-center text-sm font-semibold text-amber-400 hover:text-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-400 rounded-md px-2 py-1 -ml-2 transition-colors" do %>
      <svg class="w-5 h-5 mr-2 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>Volver a Endpoints API</span>
    <% end %>
  </div>

  <main class="bg-[#1a120b] border-2 border-amber-700/60 rounded-2xl p-6 sm:p-8 shadow-2xl">
    <header class="border-b border-amber-700/50 pb-5 mb-6">
      <h1 class="text-2xl font-bold tracking-tight text-white">Editar Endpoint API</h1>
      <p class="text-sm text-amber-100/90 mt-1">Modifica los parámetros de comprobación del servicio.</p>
    </header>

    <%= form_with(model: @api_endpoint, class: "space-y-6") do |f| %>
      <% if @api_endpoint.errors.any? %>
        <div class="p-4 rounded-xl bg-red-950/80 border-2 border-red-500 text-sm font-medium text-red-100">
          <h3 class="font-bold mb-2"><%= pluralize(@api_endpoint.errors.count, "error") %> impidieron guardar este endpoint:</h3>
          <ul class="list-disc list-inside space-y-1">
            <% @api_endpoint.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Nombre del Endpoint", class: "block text-sm font-bold text-white mb-2" %>
        <%= f.text_field :name, class: "w-full px-4 py-3 rounded-xl bg-[#0d0905] border-2 border-amber-600/70 text-white placeholder-amber-200/40 text-base focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" %>
      </div>

      <div>
        <%= f.label :url, "URL Completa", class: "block text-sm font-bold text-white mb-2" %>
        <%= f.url_field :url, class: "w-full px-4 py-3 rounded-xl bg-[#0d0905] border-2 border-amber-600/70 text-white placeholder-amber-200/40 text-base focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :http_method, "Método HTTP", class: "block text-sm font-bold text-white mb-2" %>
          <%= f.select :http_method, ["GET", "POST", "PUT", "PATCH", "DELETE"], {}, class: "w-full px-4 py-3 rounded-xl bg-[#0d0905] border-2 border-amber-600/70 text-white text-base focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all cursor-pointer" %>
        </div>

        <% if f.object.respond_to?(:expected_status_code) %>
          <div>
            <%= f.label :expected_status_code, "Código Esperado (Status)", class: "block text-sm font-bold text-white mb-2" %>
            <%= f.number_field :expected_status_code, class: "w-full px-4 py-3 rounded-xl bg-[#0d0905] border-2 border-amber-600/70 text-white placeholder-amber-200/40 text-base focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" %>
          </div>
        <% end %>
      </div>

      <% if f.object.respond_to?(:headers) %>
        <div>
          <%= f.label :headers, "Cabeceras (JSON opcional)", class: "block text-sm font-bold text-white mb-2" %>
          <%= f.text_area :headers, rows: 3, class: "w-full px-4 py-3 rounded-xl bg-[#0d0905] border-2 border-amber-600/70 text-white font-mono text-sm placeholder-amber-200/40 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" %>
        </div>
      <% end %>

      <% if f.object.respond_to?(:payload) %>
        <div>
          <%= f.label :payload, "Cuerpo de Petición / Body (JSON opcional)", class: "block text-sm font-bold text-white mb-2" %>
          <%= f.text_area :payload, rows: 3, class: "w-full px-4 py-3 rounded-xl bg-[#0d0905] border-2 border-amber-600/70 text-white font-mono text-sm placeholder-amber-200/40 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all" %>
        </div>
      <% end %>

      <div class="pt-4 flex items-center justify-end gap-4 border-t border-amber-700/50">
        <%= link_to "Cancelar", api_endpoints_path, class: "px-5 py-2.5 rounded-xl border border-amber-600/50 text-amber-200 hover:text-white hover:bg-amber-950/40 text-sm font-bold transition-all" %>
        <%= f.submit "Guardar Cambios", class: "px-7 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-extrabold text-sm tracking-wide shadow-lg hover:shadow-amber-400/20 focus:outline-none focus:ring-4 focus:ring-amber-400/50 transition-all cursor-pointer" %>
      </div>
    <% end %>
  </main>
</div>
