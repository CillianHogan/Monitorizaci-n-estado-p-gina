<div class="max-w-6xl mx-auto px-4 py-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Endpoints API Monitorizados</h1>
      <p class="text-sm text-amber-200/80 mt-1">Supervisión en tiempo real de servicios REST y respuestas HTTP.</p>
    </div>
    <%= link_to "+ Nuevo Endpoint", new_api_endpoint_path, class: "inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-extrabold text-sm shadow-lg hover:shadow-amber-400/20 transition-all" %>
  </div>

  <% total_endpoints = @api_endpoints.size %>
  <% up_endpoints = @api_endpoints.count { |e| e.status.to_s == "up" } %>
  <% down_endpoints = total_endpoints - up_endpoints %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-[#1a120b] border-2 border-amber-800/40 rounded-2xl p-5 shadow-lg">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300/70">TOTAL ENDPOINTS</span>
      <div class="text-3xl font-extrabold text-white mt-1"><%= total_endpoints %></div>
    </div>
    <div class="bg-[#1a120b] border-2 border-emerald-900/40 rounded-2xl p-5 shadow-lg">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-300/80">OPERATIVOS</span>
      </div>
      <div class="text-3xl font-extrabold text-emerald-400 mt-1"><%= up_endpoints %></div>
    </div>
    <div class="bg-[#1a120b] border-2 border-red-900/40 rounded-2xl p-5 shadow-lg">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-red-300/80">INCIDENTES</span>
      </div>
      <div class="text-3xl font-extrabold text-red-400 mt-1"><%= down_endpoints %></div>
    </div>
  </div>

  <div class="space-y-3">
    <% if @api_endpoints.empty? %>
      <div class="bg-[#1a120b] border-2 border-amber-800/30 rounded-2xl p-12 text-center text-amber-200/70">
        No hay endpoints registrados. Pulsa en "+ Nuevo Endpoint" para comenzar.
      </div>
    <% else %>
      <% @api_endpoints.each do |endpoint| %>
        <% is_up = endpoint.status.to_s == "up" %>
        <div class="bg-[#1a120b] hover:bg-[#22180f] border-2 <%= is_up ? "border-amber-900/40" : "border-red-900/60" %> rounded-2xl p-4 sm:p-5 transition-all shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5 min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="relative flex h-3 w-3">
                <% if is_up %>
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                <% else %>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                <% end %>
              </span>
              <h2 class="text-base sm:text-lg font-bold text-white truncate"><%= endpoint.name %></h2>
              <span class="px-2 py-0.5 text-xs font-mono font-bold rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase">
                <%= endpoint.http_method %>
              </span>
              <span class="px-2.5 py-0.5 text-xs font-bold rounded-full <%= is_up ? "bg-emerald-950/80 text-emerald-400 border border-emerald-500/40" : "bg-red-950/80 text-red-300 border border-red-500/40" %> uppercase tracking-wider">
                <%= is_up ? "ONLINE" : "CAÍDO" %>
              </span>
            </div>
            <div class="text-xs text-amber-200/60 font-mono truncate">
              <%= endpoint.url %>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end md:self-center">
            <%= link_to "Ver", api_endpoint_path(endpoint), class: "px-3 py-1.5 rounded-xl bg-[#0d0905] border border-amber-700/50 text-amber-300 hover:text-white hover:border-amber-400 text-xs font-bold transition-all" %>
            <%= link_to "Editar", edit_api_endpoint_path(endpoint), class: "px-3 py-1.5 rounded-xl bg-[#0d0905] border border-amber-700/50 text-amber-300 hover:text-white hover:border-amber-400 text-xs font-bold transition-all" %>
            <%= button_to "Eliminar", api_endpoint_path(endpoint), method: :delete, data: { turbo_confirm: "¿Deseas eliminar este endpoint?" }, class: "px-3 py-1.5 rounded-xl bg-[#0d0905] border border-red-800/50 text-red-400 hover:text-red-200 hover:bg-red-950/40 text-xs font-bold transition-all cursor-pointer" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
