<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">API Endpoints</h1>
    <%= link_to 'New API Endpoint', new_api_endpoint_path, class: 'bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded' %>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @api_endpoints.each do |api_endpoint| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= api_endpoint.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= api_endpoint.url %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= api_endpoint.status == 'up' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= api_endpoint.status %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to 'View', api_endpoint_path(api_endpoint), class: 'text-blue-600 hover:text-blue-900 mr-4' %>
              <%= link_to 'Edit', edit_api_endpoint_path(api_endpoint), class: 'text-indigo-600 hover:text-indigo-900 mr-4' %>
              <%= link_to 'Delete', api_endpoint_path(api_endpoint), method: :delete, data: { confirm: 'Are you sure?' }, class: 'text-red-600 hover:text-red-900' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>