<div class="space-y-8">
  <%# Header %>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-amber-500/20">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Endpoints API Monitorizados</h1>
      <p class="mt-1 text-sm text-amber-200/70">Supervisión en tiempo real de servicios REST, códigos HTTP y latencia.</p>
    </div>

    <div class="flex items-center gap-3">
      <% if current_user %>
        <span class="text-xs px-3 py-1.5 rounded-lg border font-medium <%= current_user.can_create_api_endpoint? ? 'border-stone-700 text-stone-400 bg-stone-900/50' : 'border-amber-500/40 text-amber-400 bg-amber-500/10' %>">
          <%= current_user.api_endpoints.count %> / <%= current_user.api_endpoint_limit %> endpoints
        </span>
      <% end %>
      <%= link_to new_api_endpoint_path, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs tracking-wide text-stone-950 bg-gradient-to-r from-amber-400 via-amber-300 to-orange-400 hover:from-amber-300 hover:to-orange-300 shadow-lg shadow-amber-500/25 hover:scale-[1.02] transition-all cursor-pointer" do %>
        <svg class="w-4 h-4 text-stone-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span>Nuevo Endpoint</span>
      <% end %>
    </div>
  </div>

  <%# Tarjetas de resumen %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-[#241a16]/80 border border-amber-500/20 rounded-2xl p-4 backdrop-blur-sm shadow-sm">
      <div class="text-xs font-semibold text-amber-200/70 uppercase tracking-wider">Total Endpoints</div>
      <div class="mt-1 text-2xl font-black text-white font-mono"><%= @total_count || @api_endpoints.size %></div>
    </div>
    <div class="bg-[#241a16]/80 border border-emerald-500/30 rounded-2xl p-4 backdrop-blur-sm shadow-sm">
      <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Operativos
      </div>
      <div class="mt-1 text-2xl font-black text-emerald-300 font-mono"><%= @up_count || @api_endpoints.count(&:status_up?) %></div>
    </div>
    <div class="bg-[#241a16]/80 border border-rose-500/30 rounded-2xl p-4 backdrop-blur-sm shadow-sm">
      <div class="text-xs font-semibold text-rose-400 uppercase tracking-wider flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-rose-500"></span>
        Incidentes
      </div>
      <div class="mt-1 text-2xl font-black text-rose-300 font-mono"><%= @down_count || @api_endpoints.count { |e| e.status_down? || e.status_error? } %></div>
    </div>
  </div>

  <%# Listado %>
  <% if @api_endpoints.empty? %>
    <div class="bg-[#241a16]/60 border border-dashed border-amber-500/25 rounded-3xl p-12 text-center">
      <div class="h-16 w-16 mx-auto mb-4 rounded-2xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-300">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">No tienes endpoints en monitorización</h3>
      <p class="mt-1 text-sm text-amber-200/70 max-w-sm mx-auto">Añade tu primer endpoint REST para empezar a vigilar su disponibilidad y latencia.</p>
      <div class="mt-6">
        <%= link_to "Añadir Primer Endpoint", new_api_endpoint_path, class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs text-stone-950 bg-amber-400 hover:bg-amber-300 shadow-md transition" %>
      </div>
    </div>
  <% else %>
    <div class="grid grid-cols-1 gap-3.5">
      <% @api_endpoints.each do |endpoint| %>
        <% is_up = endpoint.status_up? %>
        <% latency = endpoint.has_attribute?(:last_response_time_ms) ? endpoint.last_response_time_ms : nil %>

        <div class="bg-[#241a16]/80 hover:bg-[#2c201b]/90 border border-amber-500/20 hover:border-amber-500/40 rounded-2xl p-4 sm:p-5 backdrop-blur-sm transition-all group shadow-sm">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            
            <%# Identificador principal %>
            <div class="flex items-center gap-3.5 min-w-[260px]">
              <span class="flex h-3 w-3 relative flex-shrink-0">
                <% if is_up %>
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                <% else %>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
                <% end %>
              </span>

              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <%= link_to api_endpoint_path(endpoint), class: "text-base font-bold text-white group-hover:text-amber-300 transition-colors" do %>
                    <%= endpoint.name %>
                  <% end %>
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md font-mono bg-amber-500/15 text-amber-300 border border-amber-500/30">
                    <%= endpoint.http_method.to_s.upcase %>
                  </span>
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md <%= is_up ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-300 border border-rose-500/30' %>">
                    <%= is_up ? 'ONLINE' : 'CAÍDO' %>
                  </span>
                </div>
                <div class="flex items-center gap-2 text-xs text-amber-200/60">
                  <a href="<%= endpoint.url %>" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300 transition-colors flex items-center gap-1 font-mono">
                    <%= endpoint.url %>
                    <svg class="w-3 h-3 text-amber-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>

            <%# Métricas %>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 py-2 lg:py-0 border-y lg:border-y-0 border-amber-500/15 text-xs">
              <div>
                <span class="text-[11px] font-medium text-amber-200/60 block">Respuesta</span>
                <span class="text-sm font-bold font-mono <%= (latency.to_i > 800) ? 'text-amber-400' : 'text-amber-100' %>">
                  <%= latency.present? ? "#{latency} ms" : "—" %>
                </span>
              </div>

              <div>
                <span class="text-[11px] font-medium text-amber-200/60 block">Código HTTP</span>
                <% if endpoint.last_http_code.present? %>
                  <span class="text-xs font-semibold font-mono <%= endpoint.last_http_code.to_i < 400 ? 'text-emerald-300' : 'text-rose-400' %>">
                    HTTP <%= endpoint.last_http_code %>
                  </span>
                <% else %>
                  <span class="text-xs text-amber-200/40 font-mono">—</span>
                <% end %>
              </div>

              <div class="col-span-2 sm:col-span-1">
                <span class="text-[11px] font-medium text-amber-200/60 block">Canales</span>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono <%= (endpoint.respond_to?(:notify_email?) && endpoint.notify_email?) ? 'bg-amber-500/30 text-amber-200 border border-amber-500/30' : 'bg-black/20 text-amber-200/30' %>">Mail</span>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono <%= (endpoint.respond_to?(:notify_discord?) && endpoint.notify_discord?) ? 'bg-indigo-500/30 text-indigo-200 border border-indigo-500/30' : 'bg-black/20 text-amber-200/30' %>">Discord</span>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono <%= (endpoint.respond_to?(:notify_telegram?) && endpoint.notify_telegram?) ? 'bg-sky-500/30 text-sky-200 border border-sky-500/30' : 'bg-black/20 text-amber-200/30' %>">TG</span>
                </div>
              </div>
            </div>

            <%# Botones %>
            <div class="flex items-center gap-2 self-end lg:self-center">
              <% if endpoint.respond_to?(:public_token) && endpoint.public_token.present? %>
                <%= link_to public_status_path(endpoint.public_token), target: "_blank", title: "Ver página pública", class: "p-2 rounded-xl text-amber-200/70 hover:text-white bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 transition" do %>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                <% end %>
              <% end %>
              <%= button_to check_status_api_endpoint_path(endpoint), method: :post, title: "Comprobar ahora", class: "p-2 rounded-xl text-amber-200/70 hover:text-white bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 transition cursor-pointer" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              <% end %>

              <%= link_to edit_api_endpoint_path(endpoint), title: "Configurar", class: "p-2 rounded-xl text-amber-200/70 hover:text-white bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 transition" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              <% end %>

              <%= link_to api_endpoint_path(endpoint), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold text-xs text-amber-100 hover:text-white bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/30 transition" do %>
                <span>Panel</span>
                <svg class="w-3.5 h-3.5 text-amber-300 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              <% end %>
            </div>

          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
