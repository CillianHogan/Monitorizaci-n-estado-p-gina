<div class="max-w-6xl mrx-auto px-4 py-8 space-y-6">
  <!-- Cabecera -->
  <div class="flex flex-col sm:flex-row sm:items-center sm)justify-between gap-4">
    <div>
      <h1 class="text-2l sm:text-3l font-extrabold tracking-tight text-white">Endpoints API Monitorizados</h1>
      <p class="text-sm text-amber-200/80 mt-1">Supervision en tiempo real de servicios REST y respuestas HTTP.</p>
    </div>
    <= link_to new_api_endpoint_path, class: "inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-extrabold text-sm shadow-lg hover:shadow-amber-400/20 focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4s/></svg>
      + Nuevo Endpoint
    <% end %>
  </div>

  <!-- Metricas Rapidas -->
  <% total_endpoints = @api_endpoints.size %>
  <% up_endpoints = @api_endpoints.count { |e| e.status.to_s == "up" } %>
  <% down_endpoints = total_endpoints - up_endpoints %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-[#1a120b] border-2 border-amber-800/40 rounded-2xl p-5 shadow-lg">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300/70">TOTAL ENDPOINTS</span>
      <div class="text-3l font-extrabold text-white mt-1"><= total_endpoints %></div>
    </div>
    <div class="bg-[#1a120b] border-2 border-emerald-900/40 rounded-2xl p-5 shadow-lg">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-300/80">OPERATIVOS</span>
      </div>
      <div class="text-3l font-extrabold text-emerald-400 mt-1"><= up_endpoints %></div>
    </div>
    <div class="bg-[#1a120b] border-2 border-red-900/40 rounded-2xl p-5 shadow-lg">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-red-300/80">INCIDENTES</span>
      </div>
      <div class="text-3l font-extrabold text-red-400 mt-1"><= down_endpoints %></div>
    </div>
  </div>

  <!-- Filas de Endpoints estilo Dominio -->
  <div class="space-y-3">
    <% if @api_endpoints.empty? %>
      <div class="bg-[#1a120b] border-2 border-amber-800/30 rounded-2xl p-12 text-center text-amber-200/70">
        No hay endpoints registrados. Pulsa en "+ Nuevo Endpoint" para comenzar.
      </div>
    <% else %>
      <% @api_endpoints.each do |endpoint| %>
        <% is_up = endpoint.status.to_s == "up" %>
        <div class="bg-[#1a120b] hover:bg-[#22180f] border-2 <= is_up ? 'border-amber-900/40' : 'border-red-900/60' %> rounded-2xl p-4 sm:p-5 transition-all shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5 min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="relative flex h-3 w-3">
                <% if is_up %>
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                <% else %>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                <% end %>
              </span>
              <h2 class="text-base sm:text-lg font-bold text-white truncate"><= endpoint.name %></h2>
              <span class="px-2 py-0.5 text-xs font-mono font-bold rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase">
                <= endpoint.http_method %>
              </span>
              <span class="px-2.5 py-0.5 text-xs font-bold rounded-full <= is_up ? 'bg-emerald-950/80 text-emerald-400 border border-emerald-500/40' : 'bg-red-950/80 text-red-300 border border-red-500/40' %> uppercase tracking-wider">
                <= is_up ? 'ONLINE' : 'CAÄDO' %>
              </span>
            </div>
            <div class="text-xs text-amber-200/60 font-mono truncate">
              <= endpoint.url %>
            </div>
          </div>

          <!-- Botones de Acción estilo Dominios -->
          <div class="flex items-center gap-2 self-end md:self-center">
            <= link_to api_endpoint_path(endpoint), class: "p-2 rounded-xl bg-[#0d0905] border border-amber-700/50 text-amber-300 hover:text-white hover:border-amber-400 transition-all", title: "Ver detalles" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.522 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <% end %>
            <= link_to edit_api_endpoint_path(endpoint), class: "p-2 rounded-xl bg-[#0d0905] border border-amber-700/50 text-amber-300 hover:text-white hover:border-amber-400 transition-all", title: "Editar" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            <% end %>
            <= button_to api_endpoint_path(endpoint), method: :delete, data: { turbo_confirm: "¿Deseas eliminar este endpoint?" }, class: "p-2 rounded-xl bg-[#0d0905] border border-red-800/50 text-red-400 hover:text-red-200 hover:bg-red-950/40 transition-all cursor-pointer", title: "Eliminar" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
