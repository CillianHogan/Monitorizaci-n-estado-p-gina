<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">New API Endpoint</h1>

  <%= form_with(model: @api_endpoint, local: true, class: "space-y-4") do |f| %>
    <% if @api_endpoint.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <h2 class="font-bold"><%= pluralize(@api_endpoint.errors.count, "error") %> prohibited this API endpoint from being saved:</h2>
        <ul class="list-disc list-inside">
          <% @api_endpoint.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :url, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :url, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :http_method, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :http_method, ApiEndpoint.http_methods.keys.map { |method| [method.upcase, method] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div class="mt-6">
      <%= f.submit "Create API Endpoint", class: "bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    </div>
  <% end %>
</div>