<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">New API Endpoint</h1>

  <%= form_with(model: @api_endpoint, local: true, class: "space-y-6 bg-white p-8 rounded-xl shadow-lg border border-gray-100") do |f| %>
    <%= render "shared/validation_errors", model: @api_endpoint, error_message: "prohibited this API endpoint from being saved:" %>

    <div class="space-y-5">
      <div class="transition-all duration-200 ease-in-out transform hover:scale-[1.01]">
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "mt-1 block w-full px-4 py-3 rounded-md border border-gray-200 shadow-sm hover:border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 transition-all duration-200" %>
      </div>

      <div class="transition-all duration-200 ease-in-out transform hover:scale-[1.01]">
        <%= f.label :url, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :url, class: "mt-1 block w-full px-4 py-3 rounded-md border border-gray-200 shadow-sm hover:border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 transition-all duration-200" %>
      </div>

      <div class="transition-all duration-200 ease-in-out transform hover:scale-[1.01]">
        <%= f.label :http_method, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :http_method, ApiEndpoint.http_methods.keys.map { |method| [method.upcase, method] }, {}, class: "mt-1 block w-full px-4 py-3 rounded-md border border-gray-200 shadow-sm hover:border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 transition-all duration-200" %>
      </div>
    </div>

    <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100 mt-6">
      <%= link_to 'Cancel', api_endpoints_path, class: 'inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200' %>
      <%= f.submit "Create API Endpoint", class: "inline-flex justify-center py-2 px-6 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200 transform hover:scale-[1.02]" %>
    </div>
  <% end %>
</div>