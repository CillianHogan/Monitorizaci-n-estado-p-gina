<%= form_with(model: api_endpoint, class: "space-y-6") do |f| %>
  <%= render "shared/validation_errors", model: api_endpoint %>

  <!-- Datos Generales -->
  <div class="bg-[#1f1612]/80 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-sm space-y-4">
    <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400/80 mb-2">Información del Endpoint</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-2">
        <%= f.label :name, "Nombre del Endpoint", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.text_field :name, placeholder: "ej. API Pagos - Healthcheck", class: "w-full bg-[#140e0b] border border-amber-500/30 rounded-xl px-4 py-2.5 text-sm text-white placeholder-stone-600 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" %>
      </div>

      <div>
        <%= f.label :http_method, "Método HTTP", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.select :http_method, ApiEndpoint.http_methods.keys.map { |m| [m.upcase, m] }, {}, class: "w-full bg-[#140e0b] border border-amber-500/30 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition cursor-pointer" %>
      </div>
    </div>

    <div>
      <%= f.label :url, "URL del Endpoint", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
      <%= f.text_field :url, placeholder: "https://api.miweb.com/v1/health", class: "w-full bg-[#140e0b] border border-amber-500/30 rounded-xl px-4 py-2.5 text-sm text-white placeholder-stone-600 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition font-mono" %>
    </div>
  </div>

  <!-- Canales de Notificación -->
  <div class="bg-[#1f1612]/80 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-sm space-y-6">
    <div>
      <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400/80">Canales de Alerta</h3>
      <p class="text-xs text-amber-200/60 mt-1">Configura por dónde recibir avisos si este endpoint no responde o devuelve un código HTTP de error.</p>
    </div>

    <!-- Email -->
    <div class="border border-stone-800/80 rounded-xl p-4 bg-[#140e0b]/60 space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <%= f.check_box :notify_email, class: "rounded border-amber-500/40 text-amber-500 focus:ring-amber-500/30 bg-[#1f1612]" %>
          <%= f.label :notify_email, "Notificar por Correo Electrónico", class: "text-sm font-medium text-white cursor-pointer" %>
        </div>
        <span class="text-xs text-amber-400/60 font-mono">Recomendado</span>
      </div>
      <div>
        <%= f.label :notify_email_address, "Dirección específica (deja vacío para canal predeterminado)", class: "block text-xs text-amber-200/70 mb-1" %>
        <%= f.email_field :notify_email_address, placeholder: "Dejar vacío para usar canal predeterminado", class: "w-full bg-[#1a1310] border border-stone-800 rounded-lg px-3 py-1.5 text-xs text-white placeholder-stone-600 focus:outline-none focus:border-amber-400" %>
      </div>
    </div>

    <!-- Discord -->
    <div class="border border-stone-800/80 rounded-xl p-4 bg-[#140e0b]/60 space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <%= f.check_box :notify_discord, class: "rounded border-amber-500/40 text-amber-500 focus:ring-amber-500/30 bg-[#1f1612]" %>
          <%= f.label :notify_discord, "Notificar por Discord Webhook", class: "text-sm font-medium text-white cursor-pointer" %>
        </div>
      </div>
      <div>
        <%= f.label :discord_webhook_url, "Webhook específico (deja vacío para canal predeterminado)", class: "block text-xs text-amber-200/70 mb-1" %>
        <%= f.text_field :discord_webhook_url, placeholder: "Dejar vacío para usar canal predeterminado", class: "w-full bg-[#1a1310] border border-stone-800 rounded-lg px-3 py-1.5 text-xs text-white placeholder-stone-600 focus:outline-none focus:border-amber-400 font-mono" %>
      </div>
    </div>

    <!-- Telegram -->
    <div class="border border-stone-800/80 rounded-xl p-4 bg-[#140e0b]/60 space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <%= f.check_box :notify_telegram, class: "rounded border-amber-500/40 text-amber-500 focus:ring-amber-500/30 bg-[#1f1612]" %>
          <%= f.label :notify_telegram, "Notificar por Telegram Bot", class: "text-sm font-medium text-white cursor-pointer" %>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <%= f.label :telegram_chat_id, "Chat ID de Telegram", class: "block text-xs text-amber-200/70 mb-1" %>
          <%= f.text_field :telegram_chat_id, placeholder: "Dejar vacío para canal predeterminado", class: "w-full bg-[#1a1310] border border-stone-800 rounded-lg px-3 py-1.5 text-xs text-white placeholder-stone-600 focus:outline-none focus:border-amber-400 font-mono" %>
        </div>
        <div>
          <%= f.label :telegram_bot_token, "Bot Token (opcional)", class: "block text-xs text-amber-200/70 mb-1" %>
          <%= f.password_field :telegram_bot_token, placeholder: "Usa token del sistema si se deja vacío", class: "w-full bg-[#1a1310] border border-stone-800 rounded-lg px-3 py-1.5 text-xs text-white placeholder-stone-600 focus:outline-none focus:border-amber-400 font-mono" %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Cancelar", api_endpoints_path, class: "px-4 py-2 rounded-xl text-xs font-semibold text-stone-400 hover:text-white transition" %>
    <%= f.submit api_endpoint.new_record? ? "Crear Endpoint" : "Guardar Cambios", class: "px-5 py-2.5 rounded-xl text-xs font-bold text-stone-950 bg-amber-400 hover:bg-amber-300 shadow transition cursor-pointer" %>
  </div>
<% end %>