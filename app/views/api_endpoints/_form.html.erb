<%= form_with(model: api_endpoint, class: "space-y-6") do |f| %>
  <%= render "shared/validation_errors", model: api_endpoint %>

  <!-- Datos Generales -->
  <div class="bg-[#1f1612]/80 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-sm space-y-4">
    <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400/80 mb-2">Información del Endpoint</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-2">
        <%= f.label :name, "Nombre del Endpoint", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.text_field :name, placeholder: "ej. API Pagos - Healthcheck", class: "w-full bg-[#140e0b] border border-amber-500/30 rounded-xl px-4 py-2.5 text-sm text-white placeholder-stone-600 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" %>
      </div>

      <div>
        <%= f.label :http_method, "Método HTTP", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
        <%= f.select :http_method, ApiEndpoint.http_methods.keys.map { |m| [m.upcase, m] }, {}, class: "w-full bg-[#140e0b] border border-amber-500/30 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition cursor-pointer" %>
      </div>
    </div>

    <div>
      <%= f.label :url, "URL del Endpoint", class: "block text-xs font-semibold text-amber-200/80 mb-1" %>
      <%= f.text_field :url, placeholder: "https://api.miweb.com/v1/health", class: "w-full bg-[#140e0b] border border-amber-500/30 rounded-xl px-4 py-2.5 text-sm text-white placeholder-stone-600 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition font-mono" %>
    </div>
  </div>

  <!-- Canales de Alerta -->
  <div class="bg-[#1f1612]/80 border border-amber-500/20 rounded-2xl p-6 backdrop-blur-sm space-y-4">
    <div class="flex items-center justify-between border-b border-amber-500/20 pb-3">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400/80">Canales de Alerta</h3>
        <p class="text-xs text-amber-200/60 mt-1">Configura por dónde recibir avisos si este endpoint no responde o devuelve un código HTTP de error.</p>
      </div>
      <%= link_to "Gestionar Canales →", notification_channels_path, class: "text-xs font-semibold text-amber-400 hover:text-amber-300" %>
    </div>

    <!-- Email -->
    <% default_email_ch = current_user&.notification_channels&.by_type(:email)&.find_by(is_default: true) || current_user&.notification_channels&.by_type(:email)&.first %>
    <% email_channels = current_user&.notification_channels&.by_type(:email)&.order(is_default: :desc) %>
    <div class="p-3.5 rounded-xl bg-[#1c1512] border border-amber-500/20 space-y-2">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :notify_email, class: "h-4 w-4 rounded border-amber-500 text-amber-500 focus:ring-amber-400",
              onchange: "if (this.checked && !document.getElementById('api_endpoint_notify_email_address').value && '#{default_email_ch&.destination}') { document.getElementById('api_endpoint_notify_email_address').value = '#{default_email_ch&.destination}'; var s = document.getElementById('api_select_email'); if(s) s.value = '#{default_email_ch&.destination}'; }" %>
        <div>
          <span class="text-xs font-bold text-white block">Notificación por Email</span>
          <span class="text-[11px] text-amber-200/60 block">Recibe un correo ante caídas o códigos de error HTTP.</span>
        </div>
      </label>
      <div class="pl-7 space-y-2">
        <% if email_channels&.any? %>
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-[11px] font-semibold text-amber-300/80">Seleccionar Canal Guardado:</label>
              <button type="button" onclick="document.getElementById('api_endpoint_notify_email_address').value=''; document.getElementById('api_endpoint_notify_email_address').focus(); var sel = document.getElementById('api_select_email'); if(sel) sel.selectedIndex = -1;" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-xs font-semibold transition cursor-pointer shadow-sm"><span>+ Escribir otro correo</span></button>
            </div>
            <select id="api_select_email" onchange="document.getElementById('api_endpoint_notify_email_address').value = this.value" class="w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none cursor-pointer">
              <% email_channels.each do |ch| %>
                <option value="<%= ch.destination %>" <%= "selected" if api_endpoint.notify_email_address == ch.destination || (api_endpoint.notify_email_address.blank? && ch.is_default?) %>>
                  <%= ch.name %> (<%= ch.destination %>) <%= "★ Predeterminado" if ch.is_default? %>
                </option>
              <% end %>
            </select>
          </div>
        <% else %>
          <div class="flex justify-end">
            <%= link_to "+ Añadir canal de correo", notification_channels_path, target: "_blank", class: "text-[10px] text-amber-400 hover:text-amber-200 underline" %>
          </div>
        <% end %>
        <div>
          <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Destino específico (opcional):</label>
          <%= f.text_field :notify_email_address, id: "api_endpoint_notify_email_address", value: (api_endpoint.notify_email_address.presence || (api_endpoint.new_record? ? default_email_ch&.destination : nil)), placeholder: "ej. usuario@ejemplo.com", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
        </div>
      </div>
    </div>

    <!-- Discord -->
    <% default_discord_ch = current_user&.notification_channels&.by_type(:discord)&.find_by(is_default: true) || current_user&.notification_channels&.by_type(:discord)&.first %>
    <% discord_channels = current_user&.notification_channels&.by_type(:discord)&.order(is_default: :desc) %>
    <div class="p-3.5 rounded-xl bg-[#1c1512] border border-amber-500/20 space-y-2">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :notify_discord, class: "h-4 w-4 rounded border-amber-500 text-amber-500 focus:ring-amber-400",
              onchange: "if (this.checked && !document.getElementById('api_endpoint_discord_webhook_url').value && '#{default_discord_ch&.destination}') { document.getElementById('api_endpoint_discord_webhook_url').value = '#{default_discord_ch&.destination}'; var s = document.getElementById('api_select_discord'); if(s) s.value = '#{default_discord_ch&.destination}'; }" %>
        <div>
          <span class="text-xs font-bold text-white block">Alertas por Discord</span>
          <span class="text-[11px] text-amber-200/60 block">Envío automático mediante Webhook.</span>
        </div>
      </label>
      <div class="pl-7 space-y-2">
        <% if discord_channels&.any? %>
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-[11px] font-semibold text-amber-300/80">Seleccionar Webhook Guardado:</label>
              <button type="button" onclick="document.getElementById('api_endpoint_discord_webhook_url').value=''; document.getElementById('api_endpoint_discord_webhook_url').focus(); var sel = document.getElementById('api_select_discord'); if(sel) sel.selectedIndex = -1;" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-xs font-semibold transition cursor-pointer shadow-sm"><span>+ Escribir otro webhook</span></button>
            </div>
            <select id="api_select_discord" onchange="document.getElementById('api_endpoint_discord_webhook_url').value = this.value" class="w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none cursor-pointer">
              <% discord_channels.each do |ch| %>
                <option value="<%= ch.destination %>" <%= "selected" if api_endpoint.discord_webhook_url == ch.destination || (api_endpoint.discord_webhook_url.blank? && ch.is_default?) %>>
                  <%= ch.name %> <%= "★ Predeterminado" if ch.is_default? %>
                </option>
              <% end %>
            </select>
          </div>
        <% else %>
          <div class="flex justify-end">
            <%= link_to "+ Añadir webhook Discord", notification_channels_path, target: "_blank", class: "text-[10px] text-amber-400 hover:text-amber-200 underline" %>
          </div>
        <% end %>
        <div>
          <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Webhook específico (opcional):</label>
          <%= f.text_field :discord_webhook_url, id: "api_endpoint_discord_webhook_url", value: (api_endpoint.discord_webhook_url.presence || (api_endpoint.new_record? ? default_discord_ch&.destination : nil)), placeholder: "https://discord.com/api/webhooks/...", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
        </div>
      </div>
    </div>

    <!-- Telegram -->
    <% default_telegram_ch = current_user&.notification_channels&.by_type(:telegram)&.find_by(is_default: true) || current_user&.notification_channels&.by_type(:telegram)&.first %>
    <% telegram_channels = current_user&.notification_channels&.by_type(:telegram)&.order(is_default: :desc) %>
    <div class="p-3.5 rounded-xl bg-[#1c1512] border border-amber-500/20 space-y-2">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :notify_telegram, class: "h-4 w-4 rounded border-amber-500 text-amber-500 focus:ring-amber-400",
              onchange: "if (this.checked && !document.getElementById('api_endpoint_telegram_chat_id').value && '#{default_telegram_ch&.destination}') { document.getElementById('api_endpoint_telegram_chat_id').value = '#{default_telegram_ch&.destination}'; var s = document.getElementById('api_select_telegram'); if(s) s.value = '#{default_telegram_ch&.destination}'; }" %>
        <div>
          <span class="text-xs font-bold text-white block">Alertas por Telegram</span>
          <span class="text-[11px] text-amber-200/60 block">Notificaciones directas vía Bot de Telegram.</span>
        </div>
      </label>
      <div class="pl-7 space-y-2">
        <% if telegram_channels&.any? %>
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-[11px] font-semibold text-amber-300/80">Seleccionar Canal Telegram Guardado:</label>
              <button type="button" onclick="document.getElementById('api_endpoint_telegram_chat_id').value=''; document.getElementById('api_endpoint_telegram_chat_id').focus(); var sel = document.getElementById('api_select_telegram'); if(sel) sel.selectedIndex = -1;" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-xs font-semibold transition cursor-pointer shadow-sm"><span>+ Escribir otro chat</span></button>
            </div>
            <select id="api_select_telegram" onchange="document.getElementById('api_endpoint_telegram_chat_id').value = this.value" class="w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none cursor-pointer">
              <% telegram_channels.each do |ch| %>
                <option value="<%= ch.destination %>" <%= "selected" if api_endpoint.telegram_chat_id == ch.destination || (api_endpoint.telegram_chat_id.blank? && ch.is_default?) %>>
                  <%= ch.name %> (<%= ch.destination %>) <%= "★ Predeterminado" if ch.is_default? %>
                </option>
              <% end %>
            </select>
          </div>
        <% else %>
          <div class="flex justify-end">
            <%= link_to "+ Añadir chat Telegram", notification_channels_path, target: "_blank", class: "text-[10px] text-amber-400 hover:text-amber-200 underline" %>
          </div>
        <% end %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Chat ID de Telegram:</label>
            <%= f.text_field :telegram_chat_id, id: "api_endpoint_telegram_chat_id", value: (api_endpoint.telegram_chat_id.presence || (api_endpoint.new_record? ? default_telegram_ch&.destination : nil)), placeholder: "ej. 987654321", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-amber-300/60 mb-1">Bot Token (opcional):</label>
            <%= f.password_field :telegram_bot_token, placeholder: "Usa token predeterminado si está vacío", class: "w-full bg-[#140e0c] border border-amber-500/25 rounded-xl px-3 py-1.5 text-xs text-white placeholder-amber-200/30 focus:outline-none font-mono" %>
          </div>
        </div>
      </div>
    </div>
  </div>

    <%= link_to "Cancelar", api_endpoints_path, class: "px-4 py-2 rounded-xl text-xs font-semibold text-stone-400 hover:text-white transition" %>
    <%= f.submit api_endpoint.new_record? ? "Crear Endpoint" : "Guardar Cambios", class: "px-5 py-2.5 rounded-xl text-xs font-bold text-stone-950 bg-amber-400 hover:bg-amber-300 shadow transition cursor-pointer" %>
  </div>
<% end %>
