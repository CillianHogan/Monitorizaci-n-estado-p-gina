<div class="space-y-12 py-6">
  <!-- Encabezado -->
  <div class="text-center max-w-3xl mx-auto space-y-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider">
      <span>PLANES Y TARIFAS</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">
      Escala tu monitorización sin límites
    </h1>
    <p class="text-stone-400 text-base sm:text-lg">
      Comienza gratis y desbloquea el máximo rendimiento con alertas prioritarias y comprobaciones en tiempo real para todos tus proyectos.
    </p>
  </div>

  <% is_pro = user_signed_in? && (current_user.try(:admin?) || current_user.try(:plan) == "pro" || current_user.try(:stripe_subscription_id).present?) %>

  <!-- Grid de Planes -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto items-stretch">
    
    <!-- Plan Gratuito -->
    <div class="rounded-3xl bg-stone-900/40 border <%= !is_pro ? 'border-amber-500/40 bg-stone-900/60' : 'border-stone-800' %> p-8 flex flex-col justify-between backdrop-blur-xl relative">
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-bold text-white">Plan Gratuito</h3>
          <span class="px-2.5 py-1 rounded-lg bg-stone-800 text-stone-400 text-xs font-semibold">Básico</span>
        </div>
        <p class="text-stone-400 text-sm">Ideal para pequeños proyectos y pruebas personales.</p>
        <div class="flex items-baseline gap-1">
          <span class="text-4xl font-black text-white">0 €</span>
          <span class="text-stone-400 text-sm">/ mes</span>
        </div>

        <ul class="space-y-3 pt-4 border-t border-stone-800 text-sm text-stone-300">
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">✓</span>
            <span>Hasta <strong class="text-white">3 monitores</strong> (Dominios y APIs)</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">✓</span>
            <span>Intervalos de verificación cada 5 minutos</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">✓</span>
            <span>Supervisión básica de certificados SSL</span>
          </li>
          <li class="flex items-center gap-2.5 text-stone-500">
            <span class="font-bold">✕</span>
            <span>Sin comprobaciones manuales instantáneas</span>
          </li>
          <li class="flex items-center gap-2.5 text-stone-500">
            <span class="font-bold">✕</span>
            <span>Sin alertas prioritarias (Telegram/Discord)</span>
          </li>
        </ul>
      </div>

      <div class="pt-8 mt-6 border-t border-stone-800/80">
        <% if !is_pro %>
          <div class="w-full py-3 rounded-xl bg-stone-800 text-stone-400 text-center font-semibold text-sm cursor-default">
            ✓ Tu Plan Actual
          </div>
        <% else %>
          <%= link_to domains_path, class: "block w-full py-3 rounded-xl bg-stone-900/80 border border-stone-800 hover:border-stone-700 text-stone-400 hover:text-white text-center font-semibold text-sm transition" do %>
            Plan Básico
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Plan PRO -->
    <div class="rounded-3xl bg-stone-900/40 border <%= is_pro ? 'border-amber-500 shadow-xl shadow-amber-500/10 bg-stone-900/70' : 'border-amber-500/40' %> p-8 flex flex-col justify-between backdrop-blur-xl relative">
      <div class="absolute -top-3.5 right-8">
        <span class="px-3 py-1 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 text-stone-950 font-black text-xs uppercase tracking-wider shadow-md">
          <%= is_pro ? "TU PLAN ACTIVO" : "RECOMENDADO" %>
        </span>
      </div>

      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-bold text-white">Plan PRO</h3>
          <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold">Ilimitado</span>
        </div>
        <p class="text-stone-400 text-sm">Para desarrolladores y empresas que requieren máxima disponibilidad.</p>
        <div class="flex items-baseline gap-1">
          <span class="text-4xl font-black text-white">9,99 €</span>
          <span class="text-stone-400 text-sm">/ mes</span>
        </div>

        <ul class="space-y-3 pt-4 border-t border-stone-800 text-sm text-stone-300">
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">⚡</span>
            <span>Hasta <strong class="text-white">50 monitores</strong> (Dominios y APIs)</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">⚡</span>
            <span>Verificación cada <strong class="text-white">1 minuto</strong></span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">⚡</span>
            <span>Comprobaciones manuales instantáneas</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">⚡</span>
            <span>Alertas prioritarias (Telegram, Discord, Webhooks, Email)</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 font-bold">⚡</span>
            <span>Filtros avanzados anti-falsos positivos (reintento a los 15s)</span>
          </li>
        </ul>
      </div>

      <div class="pt-8 mt-6 border-t border-stone-800/80">
        <% if is_pro %>
          <%= link_to domains_path, class: "block w-full py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-center text-sm transition shadow-lg shadow-amber-500/20" do %>
            ✓ Plan PRO Activo — Ir al Panel
          <% end %>
        <% else %>
          <% if user_signed_in? %>
            <%= button_to checkout_path, method: :post, data: { turbo: false }, class: "w-full py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-stone-950 font-bold text-center text-sm transition shadow-lg shadow-amber-500/20 cursor-pointer" do %>
              Suscribirse al Plan PRO
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, class: "block w-full py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-stone-950 font-bold text-center text-sm transition shadow-lg shadow-amber-500/20" do %>
              Suscribirse al Plan PRO
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

  </div>
</div>
