<div class="py-12 sm:py-20 text-center space-y-16">
  <%# Hero Principal %>
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-semibold tracking-wide">
      <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
      Monitorización 24/7 de Alta Precisión
    </div>

    <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight">
      Supervisa tus dominios con <span class="bg-gradient-to-r from-amber-400 via-orange-400 to-amber-500 bg-clip-text text-transparent">máxima fiabilidad</span>
    </h1>

    <p class="text-base sm:text-lg text-stone-300 max-w-2xl mx-auto leading-relaxed">
      Detección instantánea de caídas, control de caducidad SSL y alertas en tiempo real a Discord, Telegram y Correo electrónico.
    </p>

    <div class="pt-4 flex items-center justify-center gap-4">
      <% if user_signed_in? %>
        <%= link_to domains_path, class: "inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm text-stone-950 bg-gradient-to-r from-amber-400 via-amber-300 to-orange-400 hover:from-amber-300 hover:to-orange-300 shadow-xl shadow-amber-500/25 hover:scale-[1.02] transition-all cursor-pointer" do %>
          <span>Ir a mis dominios</span>
          <svg class="w-4 h-4 text-stone-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        <% end %>
      <% else %>
        <%= link_to new_user_registration_path, class: "inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm text-stone-950 bg-gradient-to-r from-amber-400 via-amber-300 to-orange-400 hover:from-amber-300 hover:to-orange-300 shadow-xl shadow-amber-500/25 hover:scale-[1.02] transition-all cursor-pointer" do %>
          <span>Comenzar ahora</span>
          <svg class="w-4 h-4 text-stone-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Tarjetas de Funcionalidades Integradas (Sin fondos blancos toscos) %>
  <div class="pt-10">
    <div class="text-xs uppercase font-bold tracking-widest text-stone-400 mb-8">
      Capacidades de la plataforma
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-6xl mx-auto text-left">
      <%# Tarjeta 1 %>
      <div class="bg-stone-900/60 hover:bg-stone-900/90 border border-white/[0.08] hover:border-amber-500/30 rounded-2xl p-6 backdrop-blur-md transition-all duration-200 group">
        <div class="h-10 w-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-white mb-1.5">Métricas de Latencia</h3>
        <p class="text-xs text-stone-400 leading-relaxed">Registro histórico milimétrico con gráficas Retina y filtros de rango temporal.</p>
      </div>

      <%# Tarjeta 2 %>
      <div class="bg-stone-900/60 hover:bg-stone-900/90 border border-white/[0.08] hover:border-amber-500/30 rounded-2xl p-6 backdrop-blur-md transition-all duration-200 group">
        <div class="h-10 w-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-white mb-1.5">Alertas Multicanal</h3>
        <p class="text-xs text-stone-400 leading-relaxed">Notificaciones inmediatas configurables por Discord, Telegram y Correo.</p>
      </div>

      <%# Tarjeta 3 %>
      <div class="bg-stone-900/60 hover:bg-stone-900/90 border border-white/[0.08] hover:border-amber-500/30 rounded-2xl p-6 backdrop-blur-md transition-all duration-200 group">
        <div class="h-10 w-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-white mb-1.5">Vigilancia SSL</h3>
        <p class="text-xs text-stone-400 leading-relaxed">Alertas automáticas preventivas antes de que caduque cualquier certificado.</p>
      </div>

      <%# Tarjeta 4 %>
      <div class="bg-stone-900/60 hover:bg-stone-900/90 border border-white/[0.08] hover:border-amber-500/30 rounded-2xl p-6 backdrop-blur-md transition-all duration-200 group">
        <div class="h-10 w-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-white mb-1.5">Doble Verificación</h3>
        <p class="text-xs text-stone-400 leading-relaxed">Filtro Soft/Hard fail con reintento a los 15s para evitar falsos positivos.</p>
      </div>
    </div>
  </div>
</div>
